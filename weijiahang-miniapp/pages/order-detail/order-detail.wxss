page { background: #F8F9FA; padding-bottom: 60rpx; }

.status-bar { padding: 40rpx 30rpx; color: #fff; }
.status-bar.pending { background: linear-gradient(135deg, #FAAD14, #FFC53D); }
.status-bar.accepted { background: linear-gradient(135deg, #1677FF, #4096FF); }
.status-bar.arrived { background: linear-gradient(135deg, #52C41A, #73D13D); }
.status-bar.completed { background: linear-gradient(135deg, #999, #BBB); }
.st-text { font-size: 40rpx; font-weight: 600; }
.st-no { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }

.card { background: #fff; padding: 24rpx 30rpx; margin-bottom: 10rpx; }
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }

/* 保障链 */
.guarantee-chain { }
.gc-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.gc-steps { display: flex; align-items: flex-start; }
.gcs-item { text-align: center; width: 140rpx; }
.gcs-dot {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #fff; border: 3rpx solid #DDD;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #999; font-weight: 600;
  margin: 0 auto 8rpx;
}
.gcs-item.done .gcs-dot {
  background: #52C41A; border-color: #52C41A; color: #fff;
}
.gcs-label { font-size: 24rpx; color: #999; line-height: 1.4; }
.gcs-time { font-size: 20rpx; color: #52C41A; margin-top: 4rpx; }
.gcs-item.done .gcs-label { color: #333; font-weight: 500; }
.gcs-line { flex: 1; height: 3rpx; background: #EEE; margin-top: 22rpx; }
.gcs-line.done { background: #52C41A; }

/* 订单信息 */
.info-row { display: flex; padding: 14rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f9f9f9; }
.info-row .lbl { color: #999; width: 120rpx; }

/* 异常上报 */
.issue-btns { display: flex; gap: 12rpx; }
.issue-btn {
  flex: 1; padding: 16rpx 8rpx; border-radius: 12rpx;
  background: #FFF2F0; color: #FF4D4F; border: 1rpx solid #FFA39E;
  font-size: 24rpx; text-align: center;
}
.issue-note { font-size: 22rpx; color: #999; margin-top: 12rpx; }

/* 保障规则 */
.rule-item { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f9f9f9; }
.rule-icon {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #FF6B35; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700;
  margin-right: 16rpx; margin-top: 4rpx; flex-shrink: 0;
}
.rule-text { flex: 1; font-size: 26rpx; color: #555; line-height: 1.6; }
.rule-name { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 4rpx; }

.actions { padding: 20rpx 30rpx; }
.btn-primary { width: 100%; padding: 24rpx; border-radius: 16rpx; font-size: 30rpx; background: #FF6B35; color: #fff; text-align: center; border: none; margin-bottom:12rpx; }
.btn-dispute { width: 100%; padding: 24rpx; border-radius: 16rpx; font-size: 30rpx; color: #FF4D4F; text-align: center; background: #fff; border: 2rpx solid #FF4D4F; }
.btn-outline { width: 100%; padding: 24rpx; border-radius: 16rpx; font-size: 30rpx; color: #FF4D4F; text-align: center; background: #fff; border: 2rpx solid #FF4D4F; }

/* 送货追踪 */
.delivery-steps { display:flex; align-items:flex-start; padding:10rpx 0; }
.ds-step { text-align:center; width:120rpx; flex-shrink:0; }
.ds-dot { width:44rpx; height:44rpx; border-radius:50%; background:#EEE; color:#999; display:flex; align-items:center; justify-content:center; font-size:24rpx; margin:0 auto 8rpx; font-weight:600; }
.ds-step.done .ds-dot { background:#52C41A; color:#fff; }
.ds-text { font-size:22rpx; color:#999; line-height:1.3; }
.ds-step.done .ds-text { color:#333; }
.ds-line { flex:1; height:3rpx; background:#EEE; margin-top:22rpx; }
.ds-line.done { background:#52C41A; }

.vehicle-info { background:#F0F8FF; border-radius:12rpx; padding:16rpx 20rpx; margin-top:16rpx; }
.vi-row { font-size:26rpx; color:#333; padding:6rpx 0; }
.vi-note { font-size:22rpx; color:#999; margin-top:8rpx; }

page { background: #F8F9FA; }

.nav-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FFF; border-bottom: 1rpx solid #F0F0F0;
}
.nb-back { display: flex; align-items: center; gap: 6rpx; }
.nbb-text { font-size: 28rpx; color: #333; }
.nb-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.nb-placeholder { width: 100rpx; }

/* Tab切换 */
.fav-tabs { display: flex; background: #fff; border-bottom: 1rpx solid #F0F0F0; }
.ft-item {
  flex: 1; text-align: center; padding: 20rpx 0;
  font-size: 28rpx; color: #666; position: relative;
}
.ft-item.on { color: #FF6B35; font-weight: 700; }
.ft-item.on::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 48rpx; height: 5rpx; background: #FF6B35; border-radius: 3rpx;
}

/* 空态 */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 160rpx;
}
.es-title { font-size: 30rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; }
.es-desc { font-size: 26rpx; color: #999; margin-bottom: 32rpx; }
.es-btn {
  padding: 16rpx 48rpx; background: #FF6B35; color: #FFF;
  font-size: 28rpx; font-weight: 600; border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255,107,53,0.25);
}

/* 店铺列表 */
.fav-list { padding: 16rpx 20rpx; }
.fav-card {
  display: flex; align-items: center; justify-content: space-between;
  background: #FFF; border-radius: 4rpx; padding: 20rpx;
  margin-bottom: 12rpx; border: 1rpx solid #F0F0F0;
}
.fav-card:active { background: #FAFAFA; }
.fc-left { display: flex; align-items: center; gap: 16rpx; flex: 1; }
.fc-thumb {
  width: 88rpx; height: 88rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.fct-letter { font-size: 36rpx; font-weight: 700; color: #999; }
.fc-info { flex: 1; min-width: 0; }
.fc-name { font-size: 28rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 6rpx; }
.fc-meta { font-size: 24rpx; color: #999; }
.fcm-rating { color: #FF9500; margin-right: 10rpx; }
.fc-del {
  padding: 10rpx 20rpx; border-radius: 8rpx;
  font-size: 24rpx; color: #999; background: #F5F5F5;
  flex-shrink: 0; margin-left: 12rpx;
}
.fc-del:active { background: #FF4D4F; color: #FFF; }

/* 商品收藏网格 */
.fav-goods-grid {
  display: flex; flex-wrap: wrap;
  padding: 16rpx 20rpx; gap: 16rpx;
}
.fgg-card {
  width: calc(50% - 8rpx);
  background: #fff; border-radius: 4rpx; overflow: hidden;
}
.fgg-card:active { opacity: 0.85; }
.fggi-img {
  width: 100%; height: 260rpx;
  background: linear-gradient(180deg, #F8F9FA, #EEEFF1);
}
.fggi-body { padding: 14rpx 16rpx 18rpx; }
.fggi-name {
  font-size: 26rpx; color: #333; line-height: 1.4;
  display: -webkit-box; -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; overflow: hidden;
  margin-bottom: 8rpx; min-height: 72rpx;
}
.fggi-price-row { margin-bottom: 10rpx; display: flex; align-items: baseline; gap: 4rpx; }
.fggi-price { font-size: 30rpx; color: #FF6B35; font-weight: 800; }
.fggi-unit { font-size: 20rpx; color: #999; }
.fggi-actions { display: flex; gap: 8rpx; }
.fggia-cart {
  flex: 1; text-align: center; padding: 8rpx 0;
  background: #FFF0EB; color: #FF6B35; font-size: 22rpx;
  border-radius: 4rpx; font-weight: 600;
}
.fggia-cart:active { background: #FFE0D0; }
.fggia-del {
  padding: 8rpx 12rpx; background: #F5F5F5;
  color: #999; font-size: 22rpx; border-radius: 4rpx;
}
.fggia-del:active { background: #FFE0E0; }

page { background:#F5F5F5; min-height:100vh; }
.header {
  background: linear-gradient(135deg, #FF6B35, #E55A2B);
  padding: 48rpx 32rpx; color: #fff; text-align: center;
}
.header-icon {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2); display: flex;
  align-items: center; justify-content: center;
  font-size: 30rpx; margin: 0 auto 12rpx;
}
.header-title { font-size: 34rpx; font-weight: 700; }

.card { background:#fff; margin:16rpx 20rpx; border-radius:14rpx; padding:20rpx 24rpx; }
.card-title { font-size:28rpx; font-weight:600; margin-bottom:12rpx; }

/* 手风琴FAQ */
.faq-item { border-bottom:1rpx solid #f5f5f5; }
.faq-item:last-child { border-bottom:none; }
.faq-q-row { display:flex; justify-content:space-between; align-items:center; padding:20rpx 0; }
.faq-q { color:#333; font-size:28rpx; flex:1; }
.faq-arrow { font-size:28rpx; color:#ccc; transition:transform 0.2s; }
.faq-arrow.open { transform:rotate(90deg); }
.faq-a {
  max-height:0; overflow:hidden; font-size:26rpx; color:#666;
  line-height:1.6; transition:all 0.25s ease;
}
.faq-a.show { max-height:300rpx; padding-bottom:20rpx; }

/* 联系方式 */
.contact-row {
  display:flex; align-items:center; padding:22rpx 0;
  border-bottom:1rpx solid #f5f5f5; gap:16rpx;
}
.contact-row:last-child { border-bottom:none; }
.cr-icon {
  width:44rpx; height:44rpx; border-radius:12rpx;
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.cr-icon.call { background:#E6F4FF; }
.cr-icon.call::after {
  content:''; width:18rpx; height:18rpx;
  border:3rpx solid #1677FF; border-radius:50%;
}
.cr-icon.msg { background:#F6FFED; }
.cr-icon.msg::after {
  content:''; width:20rpx; height:16rpx;
  background:#52C41A; border-radius:4rpx;
}
.cr-icon.feedback {
  background:#FFF0EB; font-size:20rpx; color:#FF6B35;
}
.cr-label { flex:1; font-size:28rpx; color:#333; }
.cr-desc { font-size:24rpx; color:#999; }
.cr-arrow { font-size:28rpx; color:#CCC; }

.dispute-entry {
  display:flex; justify-content:space-between; align-items:center;
  padding:8rpx 0;
}
.de-text { font-size:28rpx; color:#FF4D4F; }
.de-arrow { font-size:26rpx; color:#FF4D4F; }

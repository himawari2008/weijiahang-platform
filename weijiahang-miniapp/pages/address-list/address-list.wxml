<!-- 收货地址列表 -->
<view class="page">

  <!-- 空态 -->
  <view class="empty" wx:if="{{addresses.length === 0}}">
    <image class="em-mascot" src="/assets/mascot-hangxiaocraft.svg" mode="aspectFit" />
    <view class="em-title">暂无收货地址</view>
    <view class="em-desc">添加收货地址，下单更便捷</view>
  </view>

  <!-- 地址卡片列表 -->
  <view class="addr-list" wx:else>
    <view class="addr-card {{item.isDefault ? 'default' : ''}}"
          wx:for="{{addresses}}" wx:key="id"
          bindtap="onTapItem" data-addr="{{item}}">

      <!-- 顶部：姓名 + 手机 + 默认标签 -->
      <view class="ac-top">
        <text class="act-name">{{item.name}}</text>
        <text class="act-phone">{{item.phone}}</text>
        <view class="act-badges">
          <text class="actb-default" wx:if="{{item.isDefault}}">默认</text>
          <text class="actb-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
        </view>
      </view>

      <!-- 地址详情 -->
      <view class="ac-addr">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</view>

      <!-- 操作 -->
      <view class="ac-actions" wx:if="{{!selectMode}}">
        <view class="aca-btn" catchtap="onTapItem" data-addr="{{item}}">编辑</view>
      </view>
    </view>
  </view>

  <!-- 底部新增按钮 -->
  <view class="add-area">
    <view class="add-btn" bindtap="onAdd">+ 新增收货地址</view>
  </view>

</view>

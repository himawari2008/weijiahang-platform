<view class="page">
  <view class="section">
    <!-- 头像 -->
    <view class="row" bindtap="onChooseAvatar">
      <text class="row-label">头像</text>
      <view class="row-right">
        <image class="avatar-preview" src="{{avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill" />
        <text class="row-arrow">›</text>
      </view>
    </view>
    <!-- 昵称 -->
    <view class="row">
      <text class="row-label">昵称</text>
      <input class="row-input" value="{{nickname}}" placeholder="请输入昵称" bindinput="onNicknameInput" />
    </view>
    <!-- 手机号 -->
    <view class="row">
      <text class="row-label">手机号</text>
      <input class="row-input" value="{{phone}}" placeholder="请输入手机号" type="number" bindinput="onPhoneInput" />
    </view>
    <!-- 性别 -->
    <view class="row">
      <text class="row-label">性别</text>
      <view class="row-right">
        <picker mode="selector" range="{{genderLabels}}" value="{{gender}}" bindchange="onGenderChange">
          <text>{{genderLabels[gender]}}</text>
        </picker>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="save-btn" bindtap="onSave">保存</view>
</view>

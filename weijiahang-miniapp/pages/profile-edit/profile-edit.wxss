page { background: #F5F5F5; min-height: 100vh; }
.section { background: #fff; margin: 20rpx 0; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid #F0F0F0;
}
.row-label { font-size: 30rpx; color: #333; width: 140rpx; }
.row-right { display: flex; align-items: center; gap: 12rpx; color: #999; font-size: 28rpx; }
.row-arrow { font-size: 32rpx; color: #CCC; }
.row-input { flex: 1; text-align: right; font-size: 28rpx; }
.avatar-preview { width: 80rpx; height: 80rpx; border-radius: 50%; }
.save-btn {
  margin: 48rpx 24rpx; background: #FF6B35; color: #fff;
  text-align: center; padding: 24rpx 0; border-radius: 16rpx;
  font-size: 32rpx; font-weight: 600;
}

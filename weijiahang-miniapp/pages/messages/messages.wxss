/** 消息列表 — 对标微信消息列表 */
page { background: #fff; height: 100vh; display: flex; flex-direction: column; }
page { --brand: #FF6B35; }

/* 搜索 */
.search-bar { padding: 16rpx 24rpx; background: #F5F5F5; }
.sb-input {
  background: #fff; border-radius: 32rpx; padding: 14rpx 24rpx;
  font-size: 28rpx; height: 64rpx;
}

/* 分类Tab */
.tab-bar {
  display: flex; padding: 0 24rpx 12rpx; background: #F5F5F5;
  border-bottom: 1rpx solid #EEE;
}
.tab {
  padding: 12rpx 28rpx; font-size: 26rpx; color: #666;
  border-radius: 24rpx; background: #fff; margin-right: 12rpx;
  position: relative;
}
.tab.on { background: var(--brand); color: #fff; font-weight: 500; }
.tab-badge {
  position: absolute; top: -6rpx; right: -8rpx;
  background: #FF4D4F; color: #fff; font-size: 20rpx;
  padding: 2rpx 8rpx; border-radius: 12rpx; min-width: 28rpx;
  text-align: center;
}

/* 列表 */
.msg-list { flex: 1; overflow-y: auto; }

.msg-item {
  display: flex; align-items: center; padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  position: relative;
}
.msg-item:active { background: #FAFAFA; }

.mi-avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 600; color: #fff;
  margin-right: 20rpx; flex-shrink: 0;
}
.mi-body { flex: 1; overflow: hidden; }
.mi-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.mi-name { font-size: 30rpx; font-weight: 500; color: #1A1A1A; }
.mi-time { font-size: 22rpx; color: #BBB; }
.mi-preview { font-size: 26rpx; color: #999; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.mi-badge {
  min-width: 36rpx; height: 36rpx; border-radius: 18rpx;
  background: #FF4D4F; color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 0 8rpx; margin-left: 12rpx; flex-shrink: 0;
}

/* 空状态 */
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #F5F5F5; display: flex; align-items: center;
  justify-content: center; font-size: 48rpx; color: #CCC;
  margin-bottom: 24rpx;
}
.empty-text { font-size: 30rpx; color: #999; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: #CCC; }

.loading-hint { text-align: center; padding: 40rpx; font-size: 26rpx; color: #CCC; }

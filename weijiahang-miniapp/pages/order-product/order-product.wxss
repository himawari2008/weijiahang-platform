page { background:#F5F5F5; padding-bottom:140rpx; }
.header { padding:24rpx 30rpx; font-size:30rpx; font-weight:700; background:#fff; }

.step-section { background:#fff; margin:10rpx 16rpx; border-radius:14rpx; padding:20rpx 24rpx; }
.step-title { font-size:28rpx; font-weight:600; margin-bottom:14rpx; }
.search-bar { display:flex; align-items:center; gap:10rpx; background:#F5F5F5; border-radius:24rpx; padding:12rpx 18rpx; margin-bottom:12rpx; font-size:26rpx; color:#999; }
.search-bar input { flex:1; font-size:26rpx; }

.goods-pool { max-height:500rpx; }
.gp-item { display:flex; align-items:center; padding:16rpx 0; border-bottom:1rpx solid #f5f5f5; }
.gp-item.on { background:#FFF8F5; margin:0 -24rpx; padding-left:24rpx; padding-right:24rpx; }
.gpi-check { width:44rpx; height:44rpx; border-radius:50%; border:2rpx solid #DDD; margin-right:14rpx; display:flex; align-items:center; justify-content:center; font-size:20rpx; color:transparent; flex-shrink:0; }
.gpi-check.picked { background:#FF6B35; border-color:#FF6B35; color:#fff; }
.gpi-info { flex:1; }
.gpi-name { font-size:28rpx; font-weight:500; }
.gpi-spec { font-size:22rpx; color:#999; }
.gpi-price { font-size:26rpx; color:#FF6B35; font-weight:600; }
.gpi-qty { width:100rpx; text-align:center; background:#FFF0EB; border-radius:8rpx; padding:10rpx; font-size:28rpx; font-weight:600; color:#FF6B35; }

/* 已选清单 */
.selected-summary { background:#FFF8F5; margin:10rpx 16rpx; border-radius:14rpx; padding:20rpx 24rpx; }
.ss-title { font-size:26rpx; font-weight:600; margin-bottom:12rpx; }
.ss-item { display:flex; align-items:center; padding:8rpx 0; font-size:26rpx; }
.ss-name { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ss-qty { width:100rpx; text-align:right; color:#666; }
.ss-sub { width:120rpx; text-align:right; font-weight:600; }
.ss-row { display:flex; justify-content:space-between; padding:8rpx 0; font-size:26rpx; color:#666; }
.ss-val { font-weight:600; color:#333; }
.ss-total { display:flex; justify-content:space-between; margin-top:12rpx; padding-top:12rpx; border-top:1rpx solid #FFD4BF; font-size:28rpx; font-weight:700; }
.ss-total-val { color:#FF6B35; font-size:36rpx; }

/* 配送 */
.d-row { display:flex; gap:14rpx; }
.d-opt { flex:1; text-align:center; padding:18rpx; border-radius:12rpx; background:#F5F5F5; font-size:26rpx; }
.d-opt.on { background:#FFF0EB; color:#FF6B35; border:2rpx solid #FF6B35; }
.addr-inp { margin-top:14rpx; background:#F5F5F5; border-radius:10rpx; padding:16rpx; font-size:26rpx; width:100%; box-sizing:border-box; }
.note-inp { margin-top:14rpx; width:100%; height:80rpx; background:#F5F5F5; border-radius:10rpx; padding:16rpx; font-size:26rpx; box-sizing:border-box; }

/* 支付流程 */
.pay-flow { background:#F9FAFB; }
.flow-steps { padding:10rpx 0; }
.flow-item { display:flex; align-items:center; gap:16rpx; padding:14rpx 0; }
.flow-num { width:44rpx; height:44rpx; border-radius:50%; background:#FF6B35; color:#fff; font-size:26rpx; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.flow-text { font-size:26rpx; color:#333; line-height:1.5; }
.flow-arrow { text-align:center; color:#CCC; font-size:24rpx; padding:4rpx 0 4rpx 22rpx; }

.submit-btn { width:calc(100% - 32rpx); margin:20rpx 16rpx; padding:24rpx; background:#FF6B35; color:#fff; border:none; border-radius:16rpx; font-size:30rpx; font-weight:700; text-align:center; }
.empty-hint { text-align:center; padding:60rpx; color:#999; font-size:28rpx; }

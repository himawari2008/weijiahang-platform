page { background:#F5F5F5; padding-bottom:100rpx; }
.header { padding:24rpx 30rpx; font-size:34rpx; font-weight:700; background:#fff; }
.card { background:#fff; margin:12rpx 20rpx; border-radius:14rpx; padding:24rpx; }
.form-group { margin-bottom:24rpx; }
.fg-label { font-size:28rpx; font-weight:600; margin-bottom:12rpx; }
.picker-val { background:#F5F5F5; padding:18rpx 20rpx; border-radius:10rpx; font-size:28rpx; }
.type-row { display:flex; flex-wrap:wrap; gap:12rpx; }
.type-tag { padding:18rpx 28rpx; border-radius:10rpx; background:#F5F5F5; font-size:26rpx; color:#666; min-width:96rpx; min-height:96rpx; display:flex; align-items:center; justify-content:center; }
.type-tag.on { background:#FFF1F0; color:#FF4D4F; border:1rpx solid #FFA39E; }
textarea { width:100%; height:180rpx; background:#F5F5F5; border-radius:10rpx; padding:16rpx; font-size:26rpx; box-sizing:border-box; }
.upload-area { }
.ua-add { width:160rpx; height:160rpx; border:2rpx dashed #DDD; border-radius:12rpx; display:flex; align-items:center; justify-content:center; font-size:26rpx; color:#999; }
.ua-preview { width:160rpx; height:160rpx; border-radius:12rpx; }
.dispute-note { display:flex; flex-direction:column; gap:8rpx; font-size:24rpx; color:#AD8B00; }
.submit-btn { width:calc(100% - 40rpx); margin:20rpx; padding:24rpx; background:#FF4D4F; color:#fff; border-radius:16rpx; font-size:30rpx; text-align:center; border:none; }
.submit-btn[disabled] { background:#CCC; }

/** AI 助手对话页 — 对标微信/美团聊天气泡风格 */
@import "/templates/loading-compass.wxss";

page { background: #EDEDED; height: 100vh; display: flex; flex-direction: column; }
page { --brand: #FF6B35; --brand-dark: #E55A2B; --brand-light: #FFF0E8; }

/* 顶栏 */
.chat-header {
  display: flex; align-items: center; padding: 16rpx 28rpx;
  background: #fff; border-bottom: 1rpx solid #EEE;
  position: sticky; top: 0; z-index: 10;
}
.ch-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #E55A2B);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: #fff;
  margin-right: 16rpx; flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(255,107,53,0.2);
}
.ch-info { flex: 1; }
.ch-name { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.ch-status { font-size: 22rpx; color: #52C41A; margin-top: 2rpx; }
.ch-actions { display: flex; align-items: center; gap: 12rpx; }
.ch-calc-btn {
  display: flex; align-items: center; gap: 4rpx;
  background: var(--brand-light); color: var(--brand); padding: 12rpx 20rpx;
  border-radius: 24rpx; font-size: 24rpx; font-weight: 500;
}
.ch-calc-btn text { font-size: 24rpx; }
.ch-new-btn {
  font-size: 24rpx; color: #999; padding: 8rpx 16rpx;
  border: 1rpx solid #DDD; border-radius: 20rpx;
}

/* 模式切换 */
.mode-switch {
  display: flex; background: #fff; padding: 0 28rpx 14rpx;
  border-bottom: 1rpx solid #EEE;
}
.ms-tab {
  flex: 1; text-align: center; padding: 16rpx 0;
  font-size: 26rpx; color: #999; border-bottom: 3rpx solid transparent;
}
.ms-tab.active { color: var(--brand); border-bottom-color: var(--brand); font-weight: 600; }

/* 消息区 */
.chat-list { flex: 1; padding: 24rpx 24rpx 0; overflow-y: auto; }

.msg { display: flex; margin-bottom: 32rpx; }
.user-msg { flex-direction: row-reverse; }
.msg-avatar { font-size: 36rpx; width: 64rpx; text-align: center; flex-shrink: 0; font-weight: 600; }
.msg-bubble {
  max-width: 72%; margin: 0 12rpx;
  background: #fff; border-radius: 14rpx; padding: 18rpx 22rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
  position: relative;
}
.user-msg .msg-bubble { background: var(--brand); color: #fff; }

.bubble-text { font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; }
.bubble-img { max-width: 300rpx; border-radius: 10rpx; margin-top: 10rpx; }

/* 流式光标动画 */
.stream-cursor {
  display: inline-block;
  animation: cursorBlink 0.8s infinite;
  color: var(--brand);
  font-weight: 400;
  margin-left: 2rpx;
}
@keyframes cursorBlink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 快捷问题 */
.quick-questions { margin-top: 12rpx; }
.qq-item {
  background: #FFF8F5; border-radius: 12rpx; padding: 16rpx 20rpx;
  margin-bottom: 8rpx; font-size: 26rpx; color: var(--brand);
  line-height: 1.5;
}
.qq-item:last-child { border-bottom: none; }
.qq-item:active { opacity: 0.7; }

/* 输入中动画 */
.typing text {
  display: inline-block; animation: dotBounce 1.4s infinite both;
  font-size: 32rpx; color: #AAA; margin: 0 2rpx;
}
.typing text:nth-child(2) { animation-delay: 0.2s; }
.typing text:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* 材料卡片 */
.material-card {
  margin-top: 12rpx; padding: 16rpx; background: #FFF8F0;
  border-radius: 10rpx; border: 1rpx solid #FFD4BF;
  border-left: 4rpx solid #FF6B35;
}
.mcard-title { font-size: 26rpx; font-weight: 600; color: #CC5500; margin-bottom: 10rpx; }
.mcard-item { margin-bottom: 12rpx; padding-bottom: 12rpx; border-bottom: 1rpx dashed #FFE0CC; }
.mcard-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.mcard-name { font-size: 26rpx; font-weight: 500; }
.mcard-spec { font-size: 22rpx; color: #999; }
.mcard-row { display: flex; justify-content: space-between; font-size: 24rpx; color: #666; margin-top: 4rpx; }
.mcard-price { color: var(--brand); font-weight: 600; }

/* 材料操作按钮 */
.mcard-actions { display: flex; gap: 12rpx; margin-top: 10rpx; }
.mca-btn {
  flex: 1; text-align: center; padding: 10rpx 0; border-radius: 8rpx;
  font-size: 24rpx; font-weight: 500;
}
.mca-btn.cart {
  background: #FFF; color: var(--brand);
  border: 1rpx solid var(--brand);
}
.mca-btn.buy {
  background: var(--brand); color: #fff;
}
.mca-btn:active { opacity: 0.8; }

/* 店铺推荐 */
.shop-rec-card {
  margin-top: 12rpx; padding: 16rpx; background: #F0F7FF;
  border-radius: 10rpx; border: 1rpx solid #BFDFFF;
  border-left: 4rpx solid #FF6B35;
}
.sr-title { font-size: 26rpx; font-weight: 600; color: #0066CC; margin-bottom: 10rpx; }
.sr-item { padding: 12rpx 0; border-bottom: 1rpx solid #e8f2fc; }
.sr-item:last-child { border-bottom: none; }
.sr-name { font-size: 26rpx; font-weight: 500; }
.sr-addr { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.sr-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.sr-price { font-size: 24rpx; color: var(--brand); font-weight: 600; }
.sr-nav { font-size: 24rpx; color: #1677FF; padding: 6rpx 16rpx; background: #e6f4ff; border-radius: 10rpx; }

/* 输入区 */
.input-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 20rpx; padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #EEE;
}
.ib-camera {
  font-size: 24rpx; padding: 6rpx 8rpx; color: #999;
  font-weight: 500; flex-shrink: 0;
}
.ib-voice {
  font-size: 24rpx; padding: 6rpx 8rpx; color: #999;
  font-weight: 500; flex-shrink: 0;
}
.ib-input {
  flex: 1; background: #F3F3F5; border-radius: 36rpx;
  padding: 16rpx 24rpx; font-size: 28rpx; height: 68rpx;
}
.ib-send {
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: #DDD; color: #fff; display: flex; align-items: center;
  justify-content: center; font-size: 24rpx; font-weight: 700;
  flex-shrink: 0;
}
.ib-send.active { background: var(--brand); box-shadow: 0 2rpx 8rpx rgba(255,107,53,0.3); }

/* 录音状态 */
.ib-recording-indicator {
  display: flex; align-items: center; gap: 12rpx;
  flex: 1; padding: 16rpx 24rpx; border-radius: 36rpx;
  background: #FFF0F0; border: 2rpx solid #FF4D4F;
}
.ib-rec-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #FF4D4F;
  animation: recPulse 0.8s infinite;
}
@keyframes recPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.6); }
}
.ib-rec-text { font-size: 28rpx; color: #FF4D4F; font-weight: 500; }
.ib-rec-hint {
  text-align: center; font-size: 22rpx; color: #999;
  padding: 8rpx 0;
}

/** 分类浏览 — 双列 */
page { background: #F5F5F5; height: 100vh; display: flex; flex-direction: column; }

.top-bar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; background: #fff; }
.tb-title { font-size: 34rpx; font-weight: 700; }
.tb-ai { background: #FFF0EB; color: #FF6B35; padding: 10rpx 20rpx; border-radius: 20rpx; font-size: 24rpx; }

/* 排序 */
.sort-bar { display: flex; align-items: center; gap: 6rpx; padding: 10rpx 16rpx; background: #fff; border-bottom:1rpx solid #f0f0f0; }
.sort-tag { padding: 10rpx 14rpx; border-radius: 6rpx; font-size: 24rpx; color: #666; white-space:nowrap; }
.sort-tag.active { color: #FF6B35; font-weight: 600; background: #FFF5F0; }
.sort-search { flex:1; margin-left:8rpx; background:#F5F5F5; border-radius:20rpx; padding:10rpx 18rpx; font-size:24rpx; }
.sort-search-clear { padding: 8rpx 12rpx; font-size: 22rpx; color: #999; }
.sort-search-clear:active { color: #333; }

/* 子类横滑 */
.sub-row { white-space: nowrap; padding: 14rpx 16rpx; background: #fff; }
.sub-chip {
  display: inline-block; padding: 10rpx 22rpx; border-radius: 18rpx;
  background: #F5F5F5; font-size: 24rpx; color: #666; margin-right: 12rpx;
}
.sub-chip.on { background: #FFF0EB; color: #FF6B35; font-weight: 500; }

/* 商品区 */
.goods-area { flex: 1; padding: 14rpx 12rpx; }
.goods-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.goods-card {
  width: calc(50% - 10rpx); margin-bottom: 16rpx;
  background: #fff; border-radius: 4rpx; overflow: hidden;
}
.gc-img { width: 100%; height: 280rpx; }
/* 商品图材质纹理占位 */
.goods-card .gc-img {
  background:
    linear-gradient(#DDD6CC 1rpx, transparent 1rpx) 0 0 / 25% 25%,
    linear-gradient(to right, #DDD6CC 1rpx, transparent 1rpx) 0 0 / 25% 25%,
    linear-gradient(180deg, #F8F4EF, #EDE6D8);
}
.gc-body { padding: 14rpx; }
.gc-name { font-size: 26rpx; color: #333; line-height: 1.4; margin-bottom: 6rpx; }
.gc-price { font-size: 30rpx; color: #FF6B35; font-weight: 700; margin-bottom: 6rpx; }
.gc-unit { font-size: 20rpx; color: #999; font-weight: 400; }
.gc-shop { font-size: 22rpx; color: #999; display: flex; gap: 6rpx; }
.gc-shop-rating { color: #FF9500; flex-shrink: 0; }
.gc-sales { font-size: 20rpx; color: #BBB; margin-top: 4rpx; }

.ellipsis-2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.list-empty { text-align: center; padding: 120rpx 0; }
.le-text { font-size: 28rpx; color: #BBB; }
.le-hint { font-size: 24rpx; color: #DDD; margin-top: 10rpx; }
.bottom-safe { height: 30rpx; }

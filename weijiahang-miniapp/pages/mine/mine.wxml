<!--
  为家航 · 我的
  品牌调性：温暖归属感
-->
<view class="page">
  <!-- ===== 品牌头部 ===== -->
  <view class="m-masthead">
    <view class="mm-bg"></view>
    <view class="mm-content">
      <!-- 头像/登录 -->
      <view class="mm-user" wx:if="{{isLogin}}" bindtap="onEditProfile">
        <image class="mm-avatar" src="{{user.avatarUrl || ''}}" mode="aspectFill" />
        <view class="mm-info">
          <view class="mm-name">{{user.nickname || '为家用户'}}</view>
          <view class="mm-phone">{{user.phone || '已绑定手机号'}}</view>
        </view>
        <text class="mm-edit-arrow">›</text>
      </view>
      <button class="mm-login-btn" wx:else bindtap="onLogin">
        <view class="mml-logo">航</view>
        <text>微信一键登录</text>
      </button>
      <!-- 品牌口号 -->
      <view class="mm-tagline">为家领航 · 买建材不迷路</view>

      <!-- 积分 + VIP 进度（粘性锚点） -->
      <view class="mm-loyalty" wx:if="{{isLogin}}">
        <view class="mml-card">
          <view class="mml-points">
            <view class="mmlp-num">{{user.points || 0}}</view>
            <view class="mmlp-label">领航积分</view>
          </view>
          <view class="mml-divider"></view>
          <view class="mml-vip">
            <view class="mmlv-badge">VIP{{user.vipLevel || 0}}</view>
            <view class="mmlv-bar">
              <view class="mmlv-fill" style="width:{{user.vipProgress || 0}}%;"></view>
            </view>
            <view class="mmlv-hint">再获{{user.vipNeed || '--'}}分升级</view>
          </view>
        </view>
        <view class="mml-actions">
          <view class="mmla-btn" bindtap="onDailyCheckin">
            <view class="mmla-icon-css checkin"></view>
            <text>签到领积分</text>
          </view>
          <view class="mmla-btn" bindtap="onInviteFriends">
            <view class="mmla-icon-css gift"></view>
            <text>邀请有礼</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 我的订单 ===== -->
  <view class="order-block card-highlight">
    <view class="ob-head flex-between">
      <text class="ob-title">我的订单</text>
      <text class="ob-all" bindtap="onAllOrders">全部订单 ›</text>
    </view>
    <view class="ob-grid">
      <view class="ob-item" bindtap="onOrderTab" data-status="pending">
        <view class="obi-dot" style="background:#FAAD14;"></view>
        <view class="obi-label">待接单</view>
        <view class="obi-badge" wx:if="{{pendingCount > 0}}">{{pendingCount}}</view>
      </view>
      <view class="ob-item" bindtap="onOrderTab" data-status="accepted">
        <view class="obi-dot" style="background:#5B9BD5;"></view>
        <view class="obi-label">进行中</view>
      </view>
      <view class="ob-item" bindtap="onOrderTab" data-status="completed">
        <view class="obi-dot" style="background:#2D8B4A;"></view>
        <view class="obi-label">已完成</view>
      </view>
      <view class="ob-item" bindtap="onAllOrders">
        <view class="obi-dot" style="background:#CCC;"></view>
        <view class="obi-label">全部</view>
      </view>
    </view>
  </view>

  <!-- ===== 功能菜单 ===== -->
  <view class="menu-group">
    <view class="menu-item" bindtap="onAddressList">
      <view class="mi-left">
        <view class="mi-icon-css addr"></view>
        <text class="mi-label">收货地址</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMyFavorites">
      <view class="mi-left">
        <view class="mi-icon-css heart"></view>
        <text class="mi-label">我的收藏</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onBrowseHistory">
      <view class="mi-left">
        <view class="mi-icon-css history"></view>
        <text class="mi-label">浏览历史</text>
        <text class="mi-extra" wx:if="{{historyCount > 0}}">{{historyCount}}条</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCoupons">
      <view class="mi-left">
        <view class="mi-icon-css coupon"></view>
        <text class="mi-label">优惠券</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMaterialList">
      <view class="mi-left">
        <view class="mi-icon-css list"></view>
        <text class="mi-label">我的材料清单</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoCart">
      <view class="mi-left">
        <view class="mi-icon-css cart"></view>
        <text class="mi-label">购物车</text>
        <text class="mi-extra" wx:if="{{cartCount > 0}}">{{cartCount}}件</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="onFeedback">
      <view class="mi-left">
        <view class="mi-icon-css chat"></view>
        <text class="mi-label">意见反馈</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onService">
      <view class="mi-left">
        <view class="mi-icon-css service"></view>
        <text class="mi-label">客服与帮助</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <view class="mi-left">
        <view class="mi-icon-css compass"></view>
        <text class="mi-label">关于为家航</text>
        <text class="mi-extra">v1.0</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onSettings">
      <view class="mi-left">
        <view class="mi-icon-css settings"></view>
        <text class="mi-label">设置</text>
      </view>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <!-- ===== 平台保障 ===== -->
  <view class="guarantee-strip">
    <text class="gs-icon">保</text>
    <view class="gs-text">
      <text class="b">三道把关</text> · 商家留底 → 领航员验货 → 你确认收货
    </view>
  </view>

  <view class="bottom-safe"></view>
</view>

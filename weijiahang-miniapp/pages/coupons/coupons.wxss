page { background: #F5F5F5; min-height: 100vh; }
.tab-bar {
  display: flex; background: #fff; padding: 12rpx 24rpx;
  border-bottom: 1rpx solid #EEE; position: sticky; top: 0; z-index: 10;
}
.tab {
  flex: 1; text-align: center; padding: 16rpx 0;
  font-size: 28rpx; color: #666; border-bottom: 3rpx solid transparent;
}
.tab.on { color: #FF6B35; border-bottom-color: #FF6B35; font-weight: 600; }

.coupon-list { padding: 20rpx 24rpx; }
.coupon-card {
  display: flex; align-items: center; background: #fff;
  border-radius: 16rpx; margin-bottom: 16rpx; padding: 24rpx;
  position: relative; overflow: hidden;
}
.coupon-card.disabled { opacity: 0.5; filter: grayscale(50%); }
.cc-left {
  width: 160rpx; text-align: center; border-right: 2rpx dashed #EEE;
  padding-right: 20rpx; flex-shrink: 0;
}
.cc-amount { font-size: 52rpx; font-weight: 800; color: #FF6B35; }
.cc-type { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.cc-right { flex: 1; padding-left: 20rpx; }
.cc-name { font-size: 28rpx; font-weight: 600; color: #1A1A1A; }
.cc-desc { font-size: 24rpx; color: #666; margin-top: 4rpx; }
.cc-condition { font-size: 22rpx; color: #FF6B35; margin-top: 6rpx; }
.cc-shop { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.cc-date { font-size: 22rpx; color: #BBB; margin-top: 6rpx; }
.cc-action {
  position: absolute; right: 24rpx; bottom: 24rpx;
  background: #FF6B35; color: #fff; font-size: 24rpx;
  padding: 8rpx 20rpx; border-radius: 20rpx; font-weight: 500;
}

.empty { text-align: center; padding: 200rpx 60rpx; }
.empty-text { font-size: 28rpx; color: #999; }

/* 城市选择页 */
page { background: #F8F9FA; padding-bottom: 40rpx; }

/* ═══ 搜索栏 ═══ */
.cs-search {
  margin: 20rpx 24rpx;
  background: #fff; border-radius: 48rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
  transition: box-shadow 0.2s;
}
.cs-search.focused {
  box-shadow: 0 2rpx 20rpx rgba(255,107,53,0.15);
}
.css-input-row {
  display: flex; align-items: center;
  padding: 18rpx 24rpx; gap: 12rpx;
}
.css-search-icon { font-size: 28rpx; opacity: 0.4; }
.css-input {
  flex: 1; font-size: 28rpx; color: #333;
  line-height: 1.4;
}
.css-input::placeholder { color: #BBB; }
.css-clear {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #E8E8E8; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #999;
}
.css-clear:active { background: #D5D5D5; }

/* ═══ 自动定位 ═══ */
.cs-locate {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #1A3A4A, #2A5A6A);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}
.csl-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 28rpx;
}
.csl-row:active { opacity: 0.9; }
.csl-left { display: flex; align-items: center; gap: 16rpx; }
.csl-pin { font-size: 44rpx; }
.csl-label { font-size: 22rpx; color: rgba(255,255,255,0.6); }
.csl-city { font-size: 32rpx; font-weight: 700; color: #fff; margin-top: 4rpx; }
.csl-btn {
  padding: 14rpx 28rpx; background: rgba(255,255,255,0.18);
  color: #fff; font-size: 24rpx; border-radius: 40rpx;
}
.csl-btn:active { background: rgba(255,255,255,0.3); }

/* ═══ 当前选择 ═══ */
.cs-current {
  display: flex; align-items: center; gap: 12rpx;
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #FFF4ED; border-radius: var(--r-lg);
  border-left: 6rpx solid var(--brand);
}
.csc-label { font-size: 24rpx; color: var(--text-3); }
.csc-name { font-size: 30rpx; font-weight: 700; color: var(--brand); }
.csc-check { font-size: 24rpx; color: var(--brand); margin-left: auto; }

/* ═══ 城市列表 ═══ */
.cs-section {
  margin: 0 24rpx 20rpx;
  background: #fff; border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 20rpx 20rpx 8rpx;
}
.css-title {
  font-size: 26rpx; color: var(--text-3); padding: 0 8rpx 16rpx;
}
.css-grid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
}
.css-item {
  flex: 0 0 calc(25% - 9rpx);   /* 4列网格 */
  display: flex; align-items: center; justify-content: center;
  padding: 22rpx 0;
  background: #F5F6F8; border-radius: 12rpx;
  font-size: 28rpx; color: var(--text-2);
}
.css-item.on {
  background: #FFF4ED; color: var(--brand); font-weight: 700;
}
.css-item:active { background: #ECECEE; }
.css-item.on:active { background: #FFE8D8; }

/* ═══ 搜索无结果 ═══ */
.cs-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 24rpx;
}
.cse-icon { font-size: 64rpx; margin-bottom: 16rpx; opacity: 0.5; }
.cse-text { font-size: 28rpx; color: var(--text-2); margin-bottom: 8rpx; }
.cse-hint { font-size: 24rpx; color: var(--text-4); }

/* 品牌 */
.cs-brand {
  text-align: center; padding: 32rpx 0; font-size: 24rpx; color: var(--text-4);
}

/* ========================================
   为家航 · 空状态通用样式
   航小匠 IP 贯穿所有空状态场景
   配合 /templates/empty-state.wxml 使用
   ======================================== */

.empty-wrap {
  display: flex; flex-direction: column; align-items: center;
  padding: 60rpx 40rpx 40rpx;
}

/* 航小匠形象区 */
.empty-figure {
  position: relative; margin-bottom: 24rpx;
  display: flex; justify-content: center;
}
.ef-mascot {
  width: 160rpx; height: 160rpx;
}
/* 对话气泡 */
.ef-bubble {
  position: absolute; top: 4rpx; right: -60rpx;
  padding: 10rpx 18rpx; background: #fff;
  border-radius: 16rpx; border: 1rpx solid #EEE;
  font-size: 22rpx; color: #666;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.ef-bubble::after {
  content: ''; position: absolute; bottom: -8rpx; left: 20rpx;
  width: 0; height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #fff;
}

/* 文案 */
.empty-title {
  font-size: 30rpx; font-weight: 600; color: #333;
  margin-bottom: 8rpx;
}
.empty-desc {
  font-size: 26rpx; color: #999;
  text-align: center; line-height: 1.6;
  margin-bottom: 32rpx;
}

/* CTA 按钮 */
.empty-cta {
  padding: 16rpx 48rpx;
  background: #FF6B35; color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx; font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255,107,53,0.25);
}

/* 双按钮 */
.empty-actions { display: flex; gap: 20rpx; }
.ea-btn {
  padding: 14rpx 32rpx;
  background: #FFF0EB; color: #FF6B35;
  border-radius: 48rpx;
  font-size: 26rpx; font-weight: 500;
}

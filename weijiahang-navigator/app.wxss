page { --bg:#F0F1F3; --card:#fff; --primary:#1677FF; --text:#1A1A2E; --text2:#666; --text3:#999; --success:#52C41A; --warning:#FAAD14; --danger:#FF4D4F; --border:#F0F0F0; font-family:-apple-system,sans-serif; font-size:28rpx; color:var(--text); background:var(--bg); }
.card { background:var(--card); border-radius:16rpx; padding:24rpx; margin:16rpx 20rpx; box-shadow:0 2rpx 12rpx rgba(0,0,0,0.04); }
.btn { border:none; border-radius:12rpx; padding:20rpx 40rpx; font-size:30rpx; font-weight:500; text-align:center; }
.btn-primary { background:var(--primary); color:#fff; }
.btn-outline { background:var(--card); color:var(--primary); border:2rpx solid var(--primary); }
.tag { display:inline-block; padding:6rpx 16rpx; border-radius:6rpx; font-size:22rpx; margin-right:10rpx; }
.ellipsis { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

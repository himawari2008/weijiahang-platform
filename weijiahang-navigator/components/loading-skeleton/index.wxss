/* 骨架屏 — 通用组件 */

.skeleton-wrapper {
  padding: 16rpx 0;
}

.sk-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 16rpx 0;
}

.sk-line {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: sk-shimmer 1.5s ease-in-out infinite;
}

@keyframes sk-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.sk-title { height: 36rpx; width: 60%; margin-bottom: 16rpx; }
.sk-text { height: 24rpx; width: 90%; margin-bottom: 12rpx; }
.sk-text.short { width: 50%; }

/* 列表项 */
.sk-list-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 12rpx 0;
}

.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.5s ease-in-out infinite;
  flex-shrink: 0;
}

.sk-list-content {
  flex: 1;
}

.sk-list-content .sk-line {
  margin-bottom: 8rpx;
}

/* 详情 */
.sk-hero {
  height: 320rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 16rpx;
  animation: sk-shimmer 1.5s ease-in-out infinite;
}

/* 网格 */
.sk-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sk-grid-item {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

/* ===== 培训中心页面样式 ===== */
/* 使用 CSS 变量，由 app.wxss 全局定义 */

/* ----- 页面容器 ----- */
.page {
  min-height: 100vh;
  background-color: var(--bg, #F5F5F5);
  padding-bottom: 40rpx;
}

/* ----- 顶部标题区 ----- */
.header {
  background: linear-gradient(135deg, var(--primary, #FF6B35) 0%, #FF8C5A 100%);
  padding: 48rpx 32rpx 36rpx;
  position: relative;
  overflow: hidden;
}

.header::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.header-count {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
}

.header-count-num {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 16rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* ----- 分类标签栏 ----- */
.tab-bar {
  background: var(--card, #FFFFFF);
  white-space: nowrap;
  padding: 0 24rpx;
  border-bottom: 2rpx solid var(--border, #EEEEEE);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 24rpx 28rpx;
  position: relative;
  min-height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

.tab-label {
  font-size: 30rpx;
  color: var(--text2, #666666);
  font-weight: 400;
  line-height: 88rpx;
}

.tab-item-active .tab-label {
  color: var(--primary, #FF6B35);
  font-weight: 600;
}

.tab-item-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 28rpx;
  right: 28rpx;
  height: 4rpx;
  background: var(--primary, #FF6B35);
  border-radius: 2rpx;
}

/* ----- 课程列表 ----- */
.course-list {
  padding: 24rpx 32rpx;
}

/* ----- 课程卡片 ----- */
.course-card {
  display: flex;
  background: var(--card, #FFFFFF);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
  min-height: 200rpx;
}

.course-card:active {
  opacity: 0.92;
  transform: scale(0.99);
}

/* ----- 左侧视频图标 ----- */
.course-left {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  margin-right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-icon-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 107, 53, 0.12), rgba(255, 107, 53, 0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.video-icon-circle::before {
  content: '';
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 107, 53, 0.2);
  box-sizing: border-box;
}

/* CSS 纯代码绘制播放三角形 */
.play-triangle {
  width: 0;
  height: 0;
  border-top: 24rpx solid transparent;
  border-bottom: 24rpx solid transparent;
  border-left: 36rpx solid var(--primary, #FF6B35);
  margin-left: 8rpx;
}

/* 已完成状态的图标覆盖层 */
.course-card .status-done .video-icon-circle {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.15), rgba(82, 196, 26, 0.08));
}

.course-card .status-done .video-icon-circle::before {
  border-color: rgba(82, 196, 26, 0.25);
}

.course-card .status-done .play-triangle {
  border-left-color: var(--success, #52C41A);
}

/* ----- 右侧课程信息 ----- */
.course-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.course-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #333333);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.course-duration {
  font-size: 26rpx;
  color: var(--text3, #999999);
  margin-top: 8rpx;
  display: block;
}

/* ----- 进度条 ----- */
.progress-wrap {
  margin-top: 16rpx;
}

.progress-bg {
  height: 12rpx;
  background: var(--border, #EEEEEE);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-fill-in_progress {
  background: linear-gradient(90deg, var(--primary, #FF6B35), #FF9A6B);
}

.progress-fill-completed {
  background: linear-gradient(90deg, var(--success, #52C41A), #73D13D);
}

.progress-fill-not_started {
  background: var(--border, #EEEEEE);
  width: 0% !important;
}

/* ----- 底部状态行 ----- */
.course-footer {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.status-tag {
  font-size: 26rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  line-height: 1.6;
}

.status-tag-in_progress {
  background: rgba(255, 107, 53, 0.1);
  color: var(--primary, #FF6B35);
}

.status-tag-completed {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success, #52C41A);
}

.status-tag-not_started {
  background: rgba(153, 153, 153, 0.1);
  color: var(--text3, #999999);
}

/* ----- 得分徽章 ----- */
.score-badge {
  margin-left: 16rpx;
  background: linear-gradient(135deg, var(--warning, #FAAD14), #FFC53D);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  display: inline-block;
  line-height: 1.6;
}

/* ----- 操作按钮行 ----- */
.action-row {
  margin-top: 20rpx;
}

/* 通用按钮样式 */
.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  padding: 0;
  min-height: 88rpx;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.action-btn-continue {
  background: linear-gradient(135deg, var(--primary, #FF6B35), #FF8C5A);
  color: #FFFFFF;
}

.action-btn-continue:active {
  opacity: 0.85;
}

.action-btn-start {
  background: var(--card, #FFFFFF);
  color: var(--primary, #FF6B35);
  border: 2rpx solid var(--primary, #FF6B35);
}

.action-btn-start:active {
  background: rgba(255, 107, 53, 0.04);
}

/* 已完成标签 */
.completed-label {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: rgba(82, 196, 26, 0.06);
  border: 2rpx solid rgba(82, 196, 26, 0.2);
  border-radius: 44rpx;
}

.completed-check {
  font-size: 32rpx;
  color: var(--success, #52C41A);
  font-weight: 700;
  margin-right: 8rpx;
}

.completed-text {
  font-size: 30rpx;
  color: var(--success, #52C41A);
  font-weight: 500;
}

/* ----- 空态 ----- */
.empty-state {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* CSS 纯代码绘制书本图标 */
.empty-book {
  width: 80rpx;
  height: 100rpx;
  border: 4rpx solid var(--text3, #CCCCCC);
  border-radius: 6rpx;
  position: relative;
  background: transparent;
}

.empty-book::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--text3, #CCCCCC);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text3, #999999);
  margin-top: 32rpx;
}

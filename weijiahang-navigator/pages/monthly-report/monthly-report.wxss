page { background: #F5F5F5; min-height: 100vh; }

/* 头部 */
.header {
  background: linear-gradient(135deg, #FF6B35, #E55A2B);
  padding: 32rpx 32rpx 0; color: #fff;
  display: flex; justify-content: center; align-items: center; gap: 40rpx;
}
.month-nav {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2); display: flex;
  align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 300;
}
.month-display { font-size: 36rpx; font-weight: 700; }
.header-sub {
  background: linear-gradient(to bottom, #E55A2B, #F5F5F5);
  padding: 12rpx 32rpx 40rpx; text-align: center;
  font-size: 24rpx; color: rgba(255,255,255,0.8);
}

/* 加载/错误 */
.loading { text-align: center; padding: 80rpx; color: #999; font-size: 28rpx; }
.error-box {
  text-align: center; padding: 80rpx; color: #FF4D4F; font-size: 28rpx;
}

/* 汇总网格 */
.summary-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16rpx; padding: 0 20rpx; margin-top: -20rpx;
}
.sg-card {
  background: #fff; border-radius: 14rpx; padding: 24rpx;
  text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.sg-value { font-size: 38rpx; font-weight: 700; color: #333; }
.sg-value.highlight { color: #FF6B35; }
.sg-label { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.sg-change { font-size: 20rpx; margin-top: 4rpx; }
.sg-change.up { color: #52C41A; }
.sg-change.down { color: #FF4D4F; }

/* 卡片 */
.card {
  background: #fff; margin: 16rpx 20rpx; border-radius: 14rpx;
  padding: 20rpx 24rpx;
}
.card-title {
  font-size: 28rpx; font-weight: 600; color: #333;
  margin-bottom: 16rpx;
}
.card.highlight-card {
  border: 2rpx solid #FF6B35; background: #FFF9F6;
}

/* 品类分布 */
.category-list { display: flex; flex-direction: column; gap: 16rpx; }
.cat-item { display: flex; align-items: center; gap: 12rpx; }
.cat-name { font-size: 24rpx; color: #666; width: 80rpx; text-align: right; flex-shrink: 0; }
.cat-bar-bg {
  flex: 1; height: 16rpx; background: #f0f0f0;
  border-radius: 8rpx; overflow: hidden;
}
.cat-bar-fill { height: 100%; border-radius: 8rpx; transition: width 0.3s; }
.cat-percent {
  font-size: 22rpx; color: #999; width: 60rpx;
  text-align: left; flex-shrink: 0;
}

/* VS 市场 */
.vs-row { display: flex; align-items: center; }
.vs-item { flex: 1; text-align: center; padding: 16rpx 0; }
.vs-label { font-size: 24rpx; color: #999; }
.vs-value { font-size: 26rpx; color: #333; font-weight: 600; margin-top: 8rpx; }
.vs-divider { width: 1rpx; height: 60rpx; background: #f0f0f0; }

/* 操作按钮 */
.actions { padding: 32rpx 40rpx; }
.btn-share {
  background: linear-gradient(135deg, #FF6B35, #E55A2B);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 600;
  border: none; padding: 24rpx 0; text-align: center;
}

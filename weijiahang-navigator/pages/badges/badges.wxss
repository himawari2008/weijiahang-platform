/* ================================
   勋章墙 - Badges Page Styles
   Brand: #FF6B35 | Touch >= 88rpx | Font >= 28rpx
   ================================ */

.page {
  min-height: 100vh;
  background-color: var(--bg, #F5F5F5);
  padding: 30rpx 30rpx 40rpx;
  box-sizing: border-box;
}

/* ---------- Header ---------- */

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
  background: var(--card, #FFFFFF);
  border-radius: 24rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  position: relative;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.header-icon::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 107, 53, 0.25);
}

.header-icon-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
  width: 40rpx;
  height: 40rpx;
  background: #FFFFFF;
  border-radius: 6rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text, #1A1A1A);
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text2, #666666);
}

/* ---------- State Wrappers (Loading / Error / Empty) ---------- */

.state-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.state-text {
  font-size: 30rpx;
  color: var(--text2, #666666);
  margin-top: 24rpx;
}

.state-hint {
  font-size: 28rpx;
  color: var(--text3, #999999);
  margin-top: 12rpx;
}

/* Loading Spinner */

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid var(--border, #E0E0E0);
  border-top-color: var(--primary, #FF6B35);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Error Icon */

.error-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--danger, #FF4D4F);
  position: relative;
}

.error-icon-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 40rpx;
  background: #FFFFFF;
  border-radius: 5rpx;
}

.error-icon-mark::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 10rpx;
  background: #FFFFFF;
  border-radius: 50%;
}

/* Retry Button */

.retry-btn {
  min-width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary, #FF6B35);
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 0 48rpx;
  margin-top: 32rpx;
}

.retry-btn:active {
  opacity: 0.8;
}

/* Empty Icon */

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--border, #E0E0E0);
  position: relative;
}

.empty-icon-shield {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 36rpx;
  height: 44rpx;
  border: 4rpx solid var(--text3, #999999);
  border-radius: 8rpx 8rpx 12rpx 12rpx;
  background: transparent;
}

.empty-icon-shield::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 3rpx solid var(--text3, #999999);
}

/* ---------- Sections ---------- */

.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #1A1A1A);
}

.section-count {
  font-size: 26rpx;
  color: var(--text3, #999999);
}

/* ---------- Badge Grid (3 columns) ---------- */

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

/* ---------- Badge Card ---------- */

.badge-card {
  width: calc((100% - 40rpx) / 3);
  background: var(--card, #FFFFFF);
  border-radius: 20rpx;
  padding: 28rpx 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  min-height: 300rpx;
}

.badge-earned {
  border: 2rpx solid var(--border, #E8E8E8);
}

.badge-locked {
  background: var(--bg, #F0F0F0);
  border: 2rpx solid var(--border, #E0E0E0);
}

/* ---------- Badge Icon ---------- */

.badge-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
  position: relative;
  flex-shrink: 0;
}

/* Earned Icon */

.earned-icon {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  border: 4rpx solid #FF6B35;
}

.checkmark {
  position: absolute;
  top: 44%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
  width: 20rpx;
  height: 34rpx;
  border: solid #FFFFFF;
  border-width: 0 5rpx 5rpx 0;
}

/* Locked Icon */

.locked-icon {
  background: var(--border, #D8D8D8);
  border: 4rpx solid #CCCCCC;
}

.lock-body {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 24rpx;
  border: 4rpx solid #999999;
  border-radius: 6rpx;
}

.lock-shackle {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid #999999;
  border-bottom: none;
  border-radius: 50% 50% 0 0;
}

/* ---------- Badge Text ---------- */

.badge-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text, #1A1A1A);
  text-align: center;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  max-width: 100%;
}

.badge-locked .badge-name {
  color: var(--text2, #888888);
}

.badge-desc {
  font-size: 22rpx;
  color: var(--text3, #999999);
  text-align: center;
  line-height: 1.3;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.badge-date {
  font-size: 22rpx;
  color: var(--success, #52C41A);
  margin-top: 12rpx;
  text-align: center;
}

/* ---------- Progress ---------- */

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: var(--border, #D8D8D8);
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.progress-fill {
  height: 100%;
  background: var(--primary, #FF6B35);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--text3, #999999);
  margin-top: 8rpx;
  text-align: center;
}

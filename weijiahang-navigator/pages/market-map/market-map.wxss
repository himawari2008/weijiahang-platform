.map-view { width: 100%; height: 100vh; }

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.bb-market-select {
  display: flex; align-items: center; gap: 8rpx;
  margin-bottom: 20rpx;
}
.bb-market-name { font-size: 32rpx; font-weight: 700; color: #1A1A2E; }
.bb-arrow { font-size: 22rpx; color: #999; }

.bb-info { margin-bottom: 16rpx; }
.bb-info-row { display: flex; margin-bottom: 12rpx; }
.bb-label { font-size: 26rpx; color: #999; width: 100rpx; flex-shrink: 0; }
.bb-value { font-size: 26rpx; color: #333; flex: 1; }

.bb-nav-btn {
  width: 100%; height: 80rpx; line-height: 80rpx; text-align: center;
  background: #FF6B35; color: #fff; font-size: 30rpx; font-weight: 700;
  border-radius: 40rpx; margin-top: 16rpx;
}

.bb-hint { text-align: center; padding: 40rpx 0; color: #ccc; font-size: 28rpx; }

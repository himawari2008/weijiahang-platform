.page { min-height: 100vh; background: #F0F1F3; }

.tab-bar { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab-item { flex: 1; text-align: center; padding: 28rpx 0; font-size: 30rpx; color: #666; position: relative; }
.tab-item.active { color: #FF6B35; font-weight: 700; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 4rpx; background: #FF6B35; border-radius: 2rpx; }

/* 帮助中心 */
.help-section { padding: 16rpx 24rpx; }
.help-item { background: #fff; border-radius: 12rpx; margin-bottom: 12rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.hi-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; }
.hi-title { font-size: 30rpx; color: #1A1A2E; font-weight: 500; flex: 1; }
.hi-arrow { font-size: 32rpx; color: #ccc; transition: transform 0.3s; transform: rotate(0deg); }
.hi-arrow.open { transform: rotate(90deg); }
.hi-body { padding: 0 24rpx 28rpx; border-top: 1rpx solid #f5f5f5; padding-top: 20rpx; }
.hi-content { font-size: 28rpx; color: #666; line-height: 1.8; white-space: pre-line; }

/* 反馈建议 */
.feedback-section { padding: 24rpx; }
.fs-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.fs-label { font-size: 28rpx; font-weight: 600; color: #1A1A2E; display: block; margin-bottom: 16rpx; }
.fs-type-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.fs-type-item { padding: 14rpx 28rpx; border-radius: 40rpx; border: 2rpx solid #eee; font-size: 26rpx; color: #666; }
.fs-type-item.selected { border-color: #FF6B35; background: #FFF5F0; color: #FF6B35; }
.fs-textarea { width: 100%; height: 200rpx; font-size: 28rpx; padding: 16rpx; border: 1rpx solid #eee; border-radius: 8rpx; box-sizing: border-box; }
.fs-count { font-size: 22rpx; color: #ccc; text-align: right; display: block; margin-top: 8rpx; }
.fs-input { width: 100%; height: 80rpx; font-size: 28rpx; padding: 0 16rpx; border: 1rpx solid #eee; border-radius: 8rpx; box-sizing: border-box; }
.fs-submit { width: 100%; height: 88rpx; line-height: 88rpx; background: #FF6B35; color: #fff; font-size: 32rpx; font-weight: 700; border-radius: 44rpx; margin-top: 24rpx; border: none; }
.fs-submit[disabled] { opacity: 0.6; }

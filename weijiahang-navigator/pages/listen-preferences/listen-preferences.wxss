page { background: #F5F5F5; min-height: 100vh; }

.header {
  background: linear-gradient(135deg, #FF6B35, #E55A2B);
  padding: 48rpx 32rpx; color: #fff; text-align: center;
}
.header-icon { font-size: 40rpx; margin-bottom: 12rpx; }
.header-title { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.header-desc { font-size: 24rpx; opacity: 0.8; line-height: 1.6; }

.card {
  background: #fff; margin: 16rpx 20rpx; border-radius: 14rpx;
  padding: 20rpx 24rpx;
}
.card-title {
  font-size: 28rpx; font-weight: 600; color: #333;
  margin-bottom: 16rpx; padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5;
}
.setting-row:last-child { border-bottom: none; }
.sr-left { flex: 1; padding-right: 20rpx; }
.sr-label { font-size: 28rpx; color: #333; display: block; }
.sr-value {
  font-size: 24rpx; color: #FF6B35; font-weight: 600;
  display: block; margin-top: 4rpx;
}
.sr-desc { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.sr-right { flex-shrink: 0; }

.actions { padding: 32rpx 40rpx; display: flex; flex-direction: column; gap: 16rpx; }
.btn-save {
  background: linear-gradient(135deg, #FF6B35, #E55A2B);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 600;
  border: none; padding: 24rpx 0; text-align: center;
}
.btn-reset {
  background: #fff; color: #999; border-radius: 44rpx; font-size: 28rpx;
  border: 2rpx solid #E8E8E8; padding: 22rpx 0; text-align: center;
}

.tip {
  text-align: center; font-size: 22rpx; color: #ccc;
  padding: 16rpx 40rpx 40rpx;
}

<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-icon">⚙</view>
    <view class="header-title">听单偏好</view>
    <view class="header-desc">设置偏好后，系统只推送符合你条件的订单</view>
  </view>

  <!-- 接单条件 -->
  <view class="card">
    <view class="card-title">接单条件</view>

    <!-- 最低金额 -->
    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">最低接单金额</text>
        <text class="sr-value">{{minIncomeText}} 元</text>
      </view>
      <view class="sr-right">
        <slider min="5" max="100" step="5" value="{{minIncome}}" bindchange="onMinIncomeChange"
          activeColor="#FF6B35" backgroundColor="#E8E8E8" block-size="20" style="width:280rpx;" />
      </view>
    </view>

    <!-- 最大距离 -->
    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">最大距离</text>
        <text class="sr-value">{{maxDistanceText}} 公里</text>
      </view>
      <view class="sr-right">
        <slider min="0.5" max="5" step="0.5" value="{{maxDistance}}" bindchange="onMaxDistanceChange"
          activeColor="#FF6B35" backgroundColor="#E8E8E8" block-size="20" style="width:280rpx;" />
      </view>
    </view>
  </view>

  <!-- 服务类型 -->
  <view class="card">
    <view class="card-title">服务类型</view>

    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">导航服务</text>
        <text class="sr-desc">带客户找到目标店铺</text>
      </view>
      <switch checked="{{navService}}" bindchange="onNavToggle" color="#FF6B35" />
    </view>

    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">陪逛服务</text>
        <text class="sr-desc">陪同浏览、比价、选品</text>
      </view>
      <switch checked="{{companionService}}" bindchange="onCompanionToggle" color="#FF6B35" />
    </view>

    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">验货服务</text>
        <text class="sr-desc">到店验收商品质量</text>
      </view>
      <switch checked="{{inspectionService}}" bindchange="onInspectionToggle" color="#FF6B35" />
    </view>
  </view>

  <!-- 提醒方式 -->
  <view class="card">
    <view class="card-title">提醒方式</view>

    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">自动接单</text>
        <text class="sr-desc">符合偏好时自动接单（建议关闭）</text>
      </view>
      <switch checked="{{autoAccept}}" bindchange="onAutoAcceptToggle" color="#FF6B35" />
    </view>

    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">声音提醒</text>
        <text class="sr-desc">新订单到达时播放提示音</text>
      </view>
      <switch checked="{{soundAlert}}" bindchange="onSoundToggle" color="#FF6B35" />
    </view>

    <view class="setting-row">
      <view class="sr-left">
        <text class="sr-label">震动提醒</text>
        <text class="sr-desc">新订单到达时手机震动</text>
      </view>
      <switch checked="{{vibrationAlert}}" bindchange="onVibrationToggle" color="#FF6B35" />
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-save" bindtap="onSave" loading="{{saving}}">
      <text>{{saving ? '保存中...' : '保存偏好'}}</text>
    </button>
    <button class="btn-reset" bindtap="onReset">恢复默认</button>
  </view>

  <!-- 底部提示 -->
  <view class="tip">保存后，系统约1分钟内生效。听单期间可随时修改。</view>
</view>

/* ============================================
   为家航领航员 — 接单大厅（含实时抢单）
   ============================================ */

.page {
  background: #F0F1F3;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* ═══════════════════════════════════════════
   Logo 栏
   ═══════════════════════════════════════════ */
.logo-bar {
  background: #FFFFFF;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #E8E8E8;
}

/* ═══════════════════════════════════════════
   顶部状态栏 — 深色渐变
   ═══════════════════════════════════════════ */
.status-header {
  background: linear-gradient(160deg, #1A1A2E 0%, #2D3561 100%);
  padding: 36rpx 30rpx 28rpx;
}

.sh-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.sh-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sh-greeting {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

/* ---- 连接状态指示器 ---- */
.sh-connection {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.shc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-connected .shc-dot {
  background: #52C41A;
  box-shadow: 0 0 8rpx rgba(82, 196, 26, 0.6);
}

.dot-reconnecting .shc-dot {
  background: #FAAD14;
  box-shadow: 0 0 8rpx rgba(250, 173, 20, 0.6);
  animation: dot-blink 1s ease-in-out infinite;
}

.dot-disconnected .shc-dot {
  background: #FF4D4F;
  box-shadow: 0 0 8rpx rgba(255, 77, 79, 0.6);
}

@keyframes dot-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.shc-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.dot-connected .shc-text { color: #52C41A; }
.dot-reconnecting .shc-text { color: #FAAD14; }
.dot-disconnected .shc-text { color: #FF4D4F; }

.sh-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* ---- 上下线开关 ---- */
.sh-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
}

.sht-switch {
  width: 56rpx;
  height: 30rpx;
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.2);
  position: relative;
  transition: background 0.2s;
}

.sht-switch.on {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
}

.sht-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  transition: left 0.2s;
}

.sht-switch.on .sht-dot {
  left: 29rpx;
}

/* ---- 今日统计 ---- */
.sh-earn-row {
  display: flex;
  align-items: center;
}

.she-item {
  flex: 1;
  text-align: center;
}

.she-val {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
}

.she-val::before {
  content: '\FFE5';
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.6;
  margin-right: 2rpx;
}

.she-label {
  color: rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
  margin-top: 6rpx;
}

.she-div {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ═══════════════════════════════════════════
   快捷入口
   ═══════════════════════════════════════════ */
.quick-row {
  display: flex;
  background: #FFFFFF;
  padding: 22rpx 30rpx;
  margin-bottom: 2rpx;
}

.qr-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #666;
}

.qr-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  margin: 0 auto 10rpx;
  position: relative;
}

.qr-label {
  font-size: 22rpx;
  color: #666;
}

.qr-icon.market { background: #E6F4FF; }
.qr-icon.market::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #1677FF;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.qr-icon.market::before {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 3rpx;
  height: 10rpx;
  background: #1677FF;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

.qr-icon.nearby { background: #FFF0EB; }
.qr-icon.nearby::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #FF6B35;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.qr-icon.nearby::before {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 3rpx;
  height: 14rpx;
  background: #FF6B35;
  transform: translateX(-50%) rotate(45deg);
  border-radius: 2rpx;
}

.qr-icon.rank { background: #FFFBE6; border: 1rpx solid #FFE58F; }
.qr-icon.rank::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 16rpx solid #FAAD14;
  transform: translateX(-50%);
}

/* 我的订单图标 — 列表 */
.qr-icon.myorders { background: #F0F5FF; }
.qr-icon.myorders::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 24rpx;
  border: 3rpx solid #2F54EB;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}
.qr-icon.myorders::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 3rpx;
  background: #2F54EB;
  transform: translate(-50%, -60%);
  box-shadow: 0 8rpx 0 #2F54EB;
  z-index: 1;
}

/* ═══════════════════════════════════════════
   实时待抢订单区域
   ═══════════════════════════════════════════ */
.pending-section {
  margin: 12rpx 20rpx 6rpx;
}

.pending-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0 14rpx;
}

.ph-dot-pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF4D4F;
  box-shadow: 0 0 0 0 rgba(255, 77, 79, 0.5);
  animation: pulse-dot 1.5s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes pulse-dot {
  0% { box-shadow: 0 0 0 0 rgba(255, 77, 79, 0.5); }
  70% { box-shadow: 0 0 0 16rpx rgba(255, 77, 79, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 77, 79, 0); }
}

.ph-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.ph-count {
  font-size: 24rpx;
  color: #FF4D4F;
  background: rgba(255, 77, 79, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: auto;
}

/* 待抢卡片 */
.pending-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 22rpx 22rpx 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 79, 0.12);
  border: 2rpx solid #FFE8E8;
  position: relative;
  overflow: hidden;
}

.pending-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #FF4D4F, #FF6B35);
}

.pc-top {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.pc-type {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  position: relative;
}

.pc-type.navigation { background: #E6F4FF; }
.pc-type.accompany { background: #FFFBE6; }
.pc-type.inspection { background: #F6FFED; }

.pct-icon {
  position: absolute;
  top: 50%;
  left: 50%;
}

.pc-type.navigation .pct-icon {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid #1677FF;
  border-right: 4rpx solid #1677FF;
  transform: translate(-50%, -50%) rotate(45deg);
}

.pc-type.accompany .pct-icon::before,
.pc-type.accompany .pct-icon::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #FA8C16;
  border-radius: 50%;
  top: -6rpx;
}
.pc-type.accompany .pct-icon::before { left: -12rpx; }
.pc-type.accompany .pct-icon::after { left: 4rpx; }

.pc-type.inspection .pct-icon {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #52C41A;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.pc-type.inspection .pct-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 14rpx;
  background: #52C41A;
  border-radius: 2rpx;
  bottom: -4rpx;
  right: -4rpx;
  transform: rotate(45deg);
}

.pc-info {
  flex: 1;
  min-width: 0;
}

.pc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.pc-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.pc-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.pc-tag {
  font-size: 20rpx;
  color: #FF6B35;
  background: rgba(255, 107, 53, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.pc-price {
  text-align: right;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.pc-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF4D4F;
  line-height: 1.1;
}

.pc-amount::before {
  content: '\FFE5';
  font-size: 26rpx;
  font-weight: 400;
  margin-right: 2rpx;
}

.pc-income {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 倒计时条 */
.pc-countdown-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.pcc-bg {
  flex: 1;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
}

.pcc-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35, #FF4D4F);
  border-radius: 4rpx;
  transition: width 1s linear;
}

.pcc-fill.urgent {
  background: linear-gradient(90deg, #FF4D4F, #FF1A1A);
  animation: bar-pulse 0.5s ease-in-out infinite alternate;
}

@keyframes bar-pulse {
  0% { opacity: 1; }
  100% { opacity: 0.6; }
}

.pcc-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #666;
  min-width: 50rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.pcc-text.urgent {
  color: #FF4D4F;
  animation: text-pulse 0.5s ease-in-out infinite alternate;
}

@keyframes text-pulse {
  0% { opacity: 1; transform: scale(1); }
  100% { opacity: 0.7; transform: scale(1.1); }
}

/* 抢单按钮 + 环形倒计时容器 */
.pc-grab-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

/* ---- 环形倒计时 ---- */
.pcg-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.pcgr-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(#F0F0F0 0deg, #F0F0F0 360deg);
  -webkit-mask: radial-gradient(transparent 50%, #000 51%);
  mask: radial-gradient(transparent 50%, #000 51%);
}

/* 使用简单的方式模拟环形进度 — 两个半圆 */
.pcgr-fill {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(#FF6B35 0deg, #FF6B35 calc(var(--remain, 100) * 3.6deg), #F0F0F0 calc(var(--remain, 100) * 3.6deg), #F0F0F0 360deg);
  -webkit-mask: radial-gradient(transparent 58%, #000 59%);
  mask: radial-gradient(transparent 58%, #000 59%);
  transition: background 1s linear;
}

.pcgr-fill.urgent {
  background: conic-gradient(#FF4D4F 0deg, #FF4D4F calc(var(--remain, 100) * 3.6deg), #FFF0F0 calc(var(--remain, 100) * 3.6deg), #FFF0F0 360deg);
  animation: ring-pulse 0.5s ease-in-out infinite alternate;
}

@keyframes ring-pulse {
  0% { opacity: 1; }
  100% { opacity: 0.6; }
}

.pcgr-inner {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.pcgr-countdown {
  font-size: 24rpx;
  font-weight: 700;
  color: #333;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.pcgr-countdown.urgent {
  color: #FF4D4F;
  animation: text-pulse 0.5s ease-in-out infinite alternate;
}

/* 抢单按钮 */
.pc-grab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  padding: 16rpx 0;
  background: linear-gradient(135deg, #FF6B35, #FF4D4F);
  border-radius: 12rpx;
  min-height: 88rpx;
}

.pc-grab:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.pcg-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.pcg-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #FFFFFF;
  border-right: 3rpx solid #FFFFFF;
  transform: rotate(45deg);
}

/* ═══════════════════════════════════════════
   筛选栏
   ═══════════════════════════════════════════ */
.filter-row {
  white-space: nowrap;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.f-chip {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F5F5;
  margin-right: 12rpx;
  min-height: 52rpx;
  line-height: 1.1;
}

.f-chip.on {
  background: #FF6B35;
  color: #FFFFFF;
}

.fc-count {
  margin-left: 6rpx;
  font-size: 24rpx;
  opacity: 0.6;
}

.f-chip.on .fc-count {
  color: #FFFFFF;
  opacity: 0.85;
}

/* ═══════════════════════════════════════════
   骨架屏
   ═══════════════════════════════════════════ */
.skeleton {
  padding: 12rpx 20rpx 20rpx;
}

.sk-card {
  display: flex;
  background: #FFFFFF;
  margin: 10rpx 0;
  border-radius: 16rpx;
  padding: 24rpx 22rpx;
  align-items: center;
}

.sk-left {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #F0F0F0;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.sk-body {
  flex: 1;
  min-width: 0;
}

.sk-right {
  flex-shrink: 0;
  text-align: right;
  min-width: 120rpx;
}

.sk-line {
  height: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.5s infinite ease-in-out;
}

.sk-line:last-child { margin-bottom: 0; }

.sk-line.w45 { width: 45%; }
.sk-line.w60 { width: 60%; }
.sk-line.w85 { width: 85%; }
.sk-line.w35 { width: 35%; }
.sk-line.w30 { width: 30%; }

.sk-btn {
  width: 90rpx;
  height: 56rpx;
  border-radius: 28rpx;
  margin-top: 8rpx;
  background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.5s infinite ease-in-out;
  margin-left: auto;
}

@keyframes sk-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ═══════════════════════════════════════════
   订单卡片
   ═══════════════════════════════════════════ */
.order-list {
  padding: 10rpx 0 30rpx;
}

.order-card {
  display: flex;
  background: #FFFFFF;
  margin: 10rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 22rpx;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.oc-left {
  margin-right: 18rpx;
  flex-shrink: 0;
}

.oc-type-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #F5F5F5;
}

.oc-type-icon.navigation {
  background: #E6F4FF;
}
.oc-type-icon.navigation::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #1677FF;
  border-right: 4rpx solid #1677FF;
  transform: translate(-50%, -50%) rotate(45deg);
}

.oc-type-icon.accompany {
  background: #FFFBE6;
}
.oc-type-icon.accompany::before,
.oc-type-icon.accompany::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #FA8C16;
  border-radius: 50%;
  top: 6rpx;
}
.oc-type-icon.accompany::before { left: 8rpx; }
.oc-type-icon.accompany::after { right: 8rpx; }

.oc-type-icon.inspection {
  background: #F6FFED;
}
.oc-type-icon.inspection::before {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #52C41A;
  border-radius: 50%;
  top: 7rpx;
  left: 7rpx;
}
.oc-type-icon.inspection::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 16rpx;
  background: #52C41A;
  border-radius: 2rpx;
  bottom: 7rpx;
  right: 7rpx;
  transform: rotate(45deg);
}

.oc-body {
  flex: 1;
  min-width: 0;
}

.oc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.oc-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-tags {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.oc-tag {
  font-size: 22rpx;
  color: #999;
  background: #F5F5F5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.oc-tag.dist {
  color: #52C41A;
  background: #F6FFED;
}

.oc-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.oc-price {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.1;
}

.oc-price::before {
  content: '\FFE5';
  font-size: 24rpx;
  font-weight: 400;
  margin-right: 2rpx;
}

.oc-income {
  font-size: 22rpx;
  color: #999;
  margin: 6rpx 0 14rpx;
}

.grab-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  min-height: 88rpx;
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
  letter-spacing: 4rpx;
}

.grab-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ═══════════════════════════════════════════
   空态
   ═══════════════════════════════════════════ */
.empty-state {
  padding: 120rpx 60rpx 80rpx;
}

.empty-box {
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: #F5F5F5;
  position: relative;
}

.empty-icon::before {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #D9D9D9;
  border-radius: 50%;
  top: 28rpx;
  left: 28rpx;
}
.empty-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 32rpx;
  background: #D9D9D9;
  border-radius: 2rpx;
  bottom: 24rpx;
  right: 28rpx;
  transform: rotate(45deg);
}

.empty-icon.error {
  background: #FFF0EB;
}
.empty-icon.error::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40rpx;
  height: 4rpx;
  background: #FF6B35;
  border-radius: 2rpx;
  border: none;
  transform: translate(-50%, -50%) rotate(45deg);
}
.empty-icon.error::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40rpx;
  height: 4rpx;
  background: #FF6B35;
  border-radius: 2rpx;
  transform: translate(-50%, -50%) rotate(-45deg);
  bottom: auto;
  right: auto;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #CCC;
  margin-top: 10rpx;
}

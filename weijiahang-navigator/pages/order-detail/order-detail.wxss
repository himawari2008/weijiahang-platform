/* ================================================================
   weijiahang-navigator — order-detail
   领航员订单详情页
   ================================================================ */

/* ---------- 加载 / 错误 ---------- */

.load-mask {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 260rpx 0;
}
.load-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: #1677FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.load-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

.err-state {
  text-align: center;
  padding: 260rpx 60rpx;
}
.err-icon-box {
  margin: 0 auto 24rpx;
}
.err-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFF1F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}
.err-exclaim {
  font-size: 48rpx;
  color: #FF4D4F;
  font-weight: 700;
  line-height: 1;
}
.err-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 32rpx;
  line-height: 1.5;
}
.err-btn {
  display: inline-block;
  width: 240rpx !important;
}

/* ==============================================================
   订单头部
   ============================================================== */

.order-header {
  padding: 48rpx 30rpx 30rpx;
  color: #fff;
  position: relative;
}
.order-header.status-accepted {
  background: linear-gradient(135deg, #1677FF 0%, #4096FF 100%);
}
.order-header.status-arrived {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
}
.order-header.status-serving {
  background: linear-gradient(135deg, #1677FF 0%, #4096FF 100%);
}
.order-header.status-completed {
  background: linear-gradient(135deg, #8C8C8C 0%, #BFBFBF 100%);
}

.oh-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.oh-order-no {
  font-size: 26rpx;
  opacity: 0.9;
  font-weight: 500;
}

.oh-type-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
}

/* 类型图标 — CSS 圆点 */
.ott-icon {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.type-navigation .ott-icon { background: #fff; }
.type-accompany .ott-icon { background: #FFE58F; }
.type-inspection .ott-icon { background: #B7EB8F; }
.type-delivery .ott-icon { background: #FFD8BF; }
.type-urgent .ott-icon { background: #FFCCC7; }

.ott-text {
  color: rgba(255, 255, 255, 0.95);
}

.oh-price {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 12rpx;
}
.oh-amount {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.oh-income {
  font-size: 26rpx;
  opacity: 0.75;
}
.oh-time {
  font-size: 22rpx;
  opacity: 0.55;
  display: block;
}

/* ==============================================================
   状态步骤条
   ============================================================== */

.steps-bar {
  display: flex;
  align-items: flex-start;
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.step-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.step-dot-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 12rpx;
}

/* -------- 圆点 -------- */

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
}
.step-dot-completed {
  width: 28rpx;
  height: 28rpx;
  background: #1677FF;
}
.step-dot-active {
  width: 28rpx;
  height: 28rpx;
  background: #1677FF;
  animation: stepPulse 2s ease-in-out infinite;
}
.step-dot-inactive {
  width: 16rpx;
  height: 16rpx;
  background: #D9D9D9;
}

/* 勾选标记 — CSS 实现 */
.step-check-icon {
  width: 12rpx;
  height: 7rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
  margin-bottom: 2rpx;
}

@keyframes stepPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(22, 119, 255, 0.35);
  }
  70% {
    box-shadow: 0 0 0 16rpx rgba(22, 119, 255, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(22, 119, 255, 0);
  }
}

/* -------- 连接线 -------- */

.step-line {
  flex: 1;
  height: 4rpx;
  margin: 0 4rpx;
  border-radius: 2rpx;
  transition: background 0.3s ease;
}
.step-line.line-completed {
  background: #1677FF;
}
.step-line.line-inactive {
  background: #E8E8E8;
}

/* -------- 标签 -------- */

.step-label {
  font-size: 22rpx;
  white-space: nowrap;
  text-align: center;
  transition: color 0.3s ease;
}
.step-label-completed {
  color: #1677FF;
  font-weight: 500;
}
.step-label-active {
  color: #1677FF;
  font-weight: 600;
}
.step-label-inactive {
  color: #BFBFBF;
}

/* ==============================================================
   店铺信息卡片
   ============================================================== */

.shop-card {
  margin-bottom: 0;
}

.sc-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.sc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}
.sc-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: #E6F4FF;
  color: #1677FF;
  font-size: 22rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.sc-address {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.sc-addr-icon {
  width: 16rpx;
  height: 16rpx;
  background: #FF6B35;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 53, 0.15);
}

.sc-desc,
.sc-remark {
  background: #FAFAFA;
  border-radius: 10rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 8rpx;
}
.sc-desc:last-child,
.sc-remark:last-child {
  margin-bottom: 0;
}
.sc-desc-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}
.sc-desc-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.55;
}

/* ==============================================================
   地图组件
   ============================================================== */

.map-section {
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  height: 280rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.order-map {
  width: 100%;
  height: 100%;
}

.map-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 14rpx 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  pointer-events: none;
}
.map-expand-icon {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #fff;
  border-radius: 4rpx;
  position: relative;
}
.map-expand-icon::after {
  content: '';
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  width: 8rpx;
  height: 8rpx;
  border-top: 3rpx solid #fff;
  border-right: 3rpx solid #fff;
}
.map-hint {
  color: #fff;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

/* ==============================================================
   服务详情 / 费用明细
   ============================================================== */

.service-card {
  margin-top: 0;
}

.srv-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 18rpx;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #555;
  border-bottom: 1rpx solid #FAFAFA;
}
.fee-row:last-of-type {
  border-bottom: none;
}

.fee-total {
  border-top: 1rpx solid #F0F0F0;
  margin-top: 8rpx;
  padding-top: 16rpx;
  font-weight: 600;
  color: #1A1A2E;
}
.fee-total-val {
  color: #1677FF;
  font-size: 32rpx;
  font-weight: 700;
}

/* -------- 验货报告 -------- */

.insp-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 18rpx 0;
}

.insp-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 12rpx;
}
.insp-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A2E;
}
.insp-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 2rpx 14rpx;
  border-radius: 4rpx;
  background: #F6FFED;
  color: #52C41A;
  font-size: 20rpx;
  line-height: 1.6;
}
.ib-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #52C41A;
}

.insp-summary {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: block;
}

.insp-images {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
  overflow-x: auto;
  padding-bottom: 4rpx;
}
.insp-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #F5F5F5;
}

/* ==============================================================
   底部操作按钮（固定）
   ============================================================== */

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 0 20rpx;
  border: none;
  line-height: 1;
}

.action-btn.btn-primary {
  background: linear-gradient(135deg, #1677FF 0%, #4096FF 100%);
  color: #fff;
}
.action-btn.btn-primary:active {
  opacity: 0.85;
}

.action-btn.btn-complete {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
  color: #fff;
}
.action-btn.btn-complete:active {
  opacity: 0.85;
}

.action-btn.btn-outline {
  background: #fff;
  color: #1677FF;
  border: 2rpx solid #1677FF;
}
.action-btn.btn-outline:active {
  background: #F0F8FF;
}

.call-btn {
  flex: 0 0 auto;
  min-width: 180rpx;
}

/* 按钮内 CSS 图标 */
.ab-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* 到达图标：向下箭头穿圆 */
.ab-icon-arrive {
  border: 3rpx solid #fff;
  border-radius: 50%;
  width: 24rpx;
  height: 24rpx;
  position: relative;
}
.ab-icon-arrive::after {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
}

/* 服务图标：小扳手/工具 */
.ab-icon-serve {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #fff;
  border-radius: 4rpx;
  position: relative;
  transform: rotate(45deg);
}
.ab-icon-serve::after {
  content: '';
  position: absolute;
  left: 4rpx;
  top: -6rpx;
  width: 6rpx;
  height: 14rpx;
  background: #fff;
  border-radius: 3rpx;
}

/* 电话图标 */
.ab-icon-call {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #1677FF;
  border-radius: 50%;
  position: relative;
}
.ab-icon-call::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 3rpx solid #1677FF;
  border-bottom: 3rpx solid #1677FF;
  transform: rotate(-45deg);
}

.btn-outline .ab-icon-call {
  border-color: #1677FF;
}
.btn-outline .ab-icon-call::after {
  border-color: #1677FF;
}

/* 完成图标：勾 */
.ab-icon-done {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  position: relative;
}
.ab-icon-done::after {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 4rpx;
  width: 10rpx;
  height: 6rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
}

/* ==============================================================
   完成态
   ============================================================== */

.done-section {
  text-align: center;
  padding: 80rpx 40rpx 60rpx;
}

.done-check-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F6FFED;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  position: relative;
}
.dcc-check {
  width: 28rpx;
  height: 16rpx;
  border-left: 5rpx solid #52C41A;
  border-bottom: 5rpx solid #52C41A;
  transform: rotate(-45deg);
  margin-bottom: 4rpx;
}

.done-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A2E;
  display: block;
  margin-bottom: 10rpx;
}
.done-income {
  font-size: 28rpx;
  color: #52C41A;
  font-weight: 500;
  display: block;
  margin-bottom: 36rpx;
}

.done-back {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 80rpx;
  padding: 0 40rpx;
}

/* ==============================================================
   底部占位（防按钮遮挡）
   ============================================================== */

.bottom-spacer {
  height: 140rpx;
}

/* ---- 转单按钮 CSS 图标 ---- */
.ab-icon-transfer {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  position: relative;
  transform: rotate(90deg);
}
.ab-icon-transfer::before,
.ab-icon-transfer::after {
  content: '';
  position: absolute;
  top: 6rpx;
  width: 6rpx;
  height: 6rpx;
  border-top: 3rpx solid #999;
  border-right: 3rpx solid #999;
}
.ab-icon-transfer::before {
  left: -8rpx;
  transform: rotate(-135deg);
}
.ab-icon-transfer::after {
  right: -8rpx;
  transform: rotate(45deg);
}

.transfer-btn {
  color: #999 !important;
  border-color: #D9D9D9 !important;
  flex: 0 0 auto;
  min-width: 130rpx;
}
.transfer-btn:active {
  background: #FAFAFA !important;
}

/* ---- 转单 Modal ---- */
.transfer-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 500;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.transfer-dialog {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  max-width: 600rpx;
  padding: 32rpx 30rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.td-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.td-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A2E;
}
.td-close {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}
.td-close::before,
.td-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 3rpx;
  background: #BFBFBF;
  border-radius: 2rpx;
}
.td-close::before { transform: translate(-50%, -50%) rotate(45deg); }
.td-close::after { transform: translate(-50%, -50%) rotate(-45deg); }

.td-body {
  margin-bottom: 32rpx;
}
.td-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 18rpx;
  display: block;
}

.td-reason-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.td-reason {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 12rpx;
  background: #F8F8F8;
  font-size: 28rpx;
  color: #333;
  transition: all 0.15s;
}
.td-reason.selected {
  background: #E6F4FF;
  color: #1677FF;
  font-weight: 500;
}

.tdr-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #D9D9D9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s;
}
.td-reason.selected .tdr-check {
  border-color: #1677FF;
  background: #1677FF;
}
.tdrc-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}

.td-footer {
  display: flex;
  gap: 16rpx;
}
.td-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}
.td-btn.cancel {
  background: #F5F5F5;
  color: #999;
}
.td-btn.confirm {
  background: linear-gradient(135deg, #1677FF, #4096FF);
  color: #fff;
}
.td-btn.confirm[disabled] {
  background: #D9D9D9;
  color: #BFBFBF;
}

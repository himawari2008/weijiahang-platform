.page { min-height: 100vh; background: #F0F1F3; padding-bottom: 40rpx; }

.nav-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 32rpx; background: #fff; border-bottom: 1rpx solid #eee;
}
.nav-title { font-size: 26rpx; color: #999; }
.nav-action { font-size: 26rpx; color: #FF6B35; }

/* 骨架 */
.skeleton-wrap { padding: 24rpx; }
.sk-item { display: flex; align-items: center; padding: 24rpx; background: #fff; border-radius: 12rpx; margin-bottom: 12rpx; }
.sk-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #e0e0e0; margin-right: 20rpx; flex-shrink: 0; }
.sk-content { flex: 1; }
.sk-line { height: 24rpx; background: #f0f0f0; border-radius: 6rpx; margin-bottom: 10rpx; animation: sk-shimmer 1.5s ease-in-out infinite; }
.sk-line.w60 { width: 60%; }
.sk-line.w90 { width: 90%; }
@keyframes sk-shimmer { 0%,100%{opacity:1} 50%{opacity:.5} }

/* 错误/空态 */
.error-wrap, .empty-wrap { text-align: center; padding: 120rpx 40rpx; }
.error-icon { width: 80rpx; height: 80rpx; line-height: 80rpx; border-radius: 50%; background: #FF4D4F; color: #fff; font-size: 36rpx; margin: 0 auto 24rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; color: #ccc; }
.error-text, .empty-text { font-size: 28rpx; color: #999; display: block; }
.btn-retry { display: inline-block; margin-top: 24rpx; padding: 16rpx 48rpx; background: #FF6B35; color: #fff; border-radius: 40rpx; font-size: 28rpx; }

/* 列表 */
.notif-list { padding: 16rpx 24rpx; }
.notif-item {
  display: flex; align-items: flex-start;
  background: #fff; border-radius: 12rpx; padding: 24rpx;
  margin-bottom: 12rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.notif-item.unread { border-left: 6rpx solid #FF6B35; }
.ni-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #FF6B35; margin-right: 16rpx; margin-top: 8rpx; flex-shrink: 0; }
.ni-body { flex: 1; min-width: 0; }
.ni-title { font-size: 30rpx; font-weight: 600; color: #1A1A2E; margin-bottom: 6rpx; }
.ni-content { font-size: 26rpx; color: #666; line-height: 1.5; margin-bottom: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ni-time { font-size: 22rpx; color: #bbb; }
.ni-arrow { font-size: 32rpx; color: #ccc; margin-left: 12rpx; flex-shrink: 0; }
.load-more { text-align: center; padding: 24rpx; color: #999; font-size: 26rpx; }

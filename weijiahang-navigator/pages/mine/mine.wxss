/* ===== 我的页 ===== */

.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

/* ---------- Logo 栏 ---------- */
.mine-logo-bar {
  background: #FFFFFF;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 头部信息卡片 ---------- */
.m-header {
  background: linear-gradient(160deg, #1A1A2E, #2D3561);
  padding: 50rpx 30rpx 36rpx;
}

.mh-avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.mh-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
}

.mh-avatar.default {
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mh-avatar-default {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 600;
}

.mh-avatar-img {
  width: 100%;
  height: 100%;
}

.mh-info {
  text-align: center;
  margin-bottom: 28rpx;
}

.mh-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mh-badge {
  font-size: 22rpx;
  color: #52C41A;
  background: rgba(82, 196, 26, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 400;
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

.mh-stat-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.mh-stat {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 0 16rpx;
}

.mh-stat-divider {
  width: 1rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.mh-balance-row {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 20rpx 30rpx;
}

.mhb-item {
  flex: 1;
  text-align: center;
}

.mhb-val {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.mhb-lbl {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.mhb-divider {
  width: 1rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* ---------- 接单开关 ---------- */
.online-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  margin: 14rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.oc-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.oc-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

/* 开关 CSS 图标 */
.sw-icon {
  border-radius: 24rpx;
  background: #E6FFFB;
  position: relative;
}

.sw-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 28rpx;
  border: 4rpx solid #13C2C2;
  border-radius: 4rpx;
  border-top: none;
  border-bottom: none;
  transform: translate(-50%, -50%);
}

.oc-text {
  display: flex;
  flex-direction: column;
}

.oc-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.oc-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.oc-switch {
  transform: scale(0.9);
}

/* ---------- 菜单分组 ---------- */
.menu-groups {
  padding: 0 24rpx;
}

.mg-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-top: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.mg-title {
  padding: 24rpx 28rpx 8rpx;
  font-size: 24rpx;
  color: #999;
}

.mg-items {
  padding: 0;
}

.mg-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.mg-item:last-child {
  border-bottom: none;
}

.mgi-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 12rpx;
  position: relative;
}

.mgi-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 48rpx;
}

.mgi-value {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
  max-width: 40vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mgi-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #CCC;
  border-right: 3rpx solid #CCC;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ===== CSS 图标集 ===== */

/* location - 位置钉 */
.mgi-icon-location {
  background: #E6F4FF;
}

.mgi-icon-location::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 24rpx;
  border: 4rpx solid #1677FF;
  border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
  border-bottom: none;
  transform: translate(-50%, -60%);
}

.mgi-icon-location::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  background: #1677FF;
  border-radius: 50%;
  transform: translate(-50%, -70%);
  z-index: 1;
}

/* skill - 标签 */
.mgi-icon-skill {
  background: #FFF0EB;
}

.mgi-icon-skill::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 14rpx;
  background: #FF6B35;
  border-radius: 0 14rpx 14rpx 0;
  transform: translate(-40%, -50%);
}

.mgi-icon-skill::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 50%;
  transform: translate(2rpx, -50%);
  z-index: 1;
}

/* car - 汽车 */
.mgi-icon-car {
  background: #F6FFED;
}

.mgi-icon-car::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 14rpx;
  background: #52C41A;
  border-radius: 6rpx;
  transform: translate(-50%, -50%);
}

.mgi-icon-car::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  background: #52C41A;
  border-radius: 50%;
  transform: translate(-50%, 10rpx);
  box-shadow: 18rpx 0 0 #52C41A, -18rpx 0 0 #52C41A;
}

/* switch - 开关 */
.mgi-icon-switch {
  background: #E6FFFB;
}

.mgi-icon-switch::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 28rpx;
  border: 4rpx solid #13C2C2;
  border-radius: 4rpx;
  border-top: none;
  border-bottom: none;
  transform: translate(-50%, -50%);
}

/* price - 价格 */
.mgi-icon-price {
  background: #FFF2E8;
}

.mgi-icon-price::after {
  content: '¥';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B35;
}

/* map - 地图 */
.mgi-icon-map {
  background: #E6FFFB;
}

.mgi-icon-map::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #13C2C2;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.mgi-icon-map::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 60%;
  width: 0;
  height: 0;
  border: 8rpx solid transparent;
  border-top-color: #13C2C2;
  border-bottom: none;
  transform: translate(-50%, 0);
}

/* book - 书本 */
.mgi-icon-book {
  background: #FFFBE6;
}

.mgi-icon-book::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 28rpx;
  border: 3rpx solid #FAAD14;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}

.mgi-icon-book::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 20rpx;
  background: #FAAD14;
  transform: translate(-50%, -50%);
}

/* chart - 图表 */
.mgi-icon-chart {
  background: #F0F5FF;
}

.mgi-icon-chart::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 4rpx;
  background: #2F54EB;
  transform: translate(-50%, -50%);
  box-shadow: 0 -10rpx 0 #2F54EB, 0 10rpx 0 #2F54EB;
}

.mgi-icon-chart::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 24rpx;
  background: #2F54EB;
  transform: translate(-50%, -50%);
}

/* badge - 勋章 */
.mgi-icon-badge {
  background: #FFFBE6;
}

.mgi-icon-badge::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 22rpx;
  border: 4rpx solid #FAAD14;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  transform: translate(-50%, -50%);
}

.mgi-icon-badge::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 55%;
  width: 8rpx;
  height: 8rpx;
  background: #FAAD14;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* wallet - 钱包 */
.mgi-icon-wallet {
  background: #E6F4FF;
}

.mgi-icon-wallet::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 22rpx;
  border: 3rpx solid #1677FF;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}

.mgi-icon-wallet::before {
  content: '';
  position: absolute;
  right: 6rpx;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #1677FF;
  border-radius: 50%;
  transform: translate(0, -50%);
}

/* shield - 盾牌 */
.mgi-icon-shield {
  background: #FFF0EB;
}

.mgi-icon-shield::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 24rpx;
  border: 4rpx solid #FF6B35;
  border-radius: 50% 50% 40% 40% / 30% 30% 40% 40%;
  border-top-width: 6rpx;
  transform: translate(-50%, -50%);
}

.mgi-icon-shield::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 45%;
  width: 6rpx;
  height: 10rpx;
  border: 2rpx solid transparent;
  border-left-color: #FF6B35;
  border-bottom-color: #FF6B35;
  transform: translate(-50%, -30%) rotate(-45deg);
}

/* bell - 铃铛 */
.mgi-icon-bell {
  background: #FFFBE6;
}

.mgi-icon-bell::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 40%;
  width: 18rpx;
  height: 20rpx;
  border: 3rpx solid #FAAD14;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
  transform: translate(-50%, 0);
}

.mgi-icon-bell::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 14rpx;
  height: 4rpx;
  background: #FAAD14;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

/* feedback - 反馈 */
.mgi-icon-feedback {
  background: #E6F4FF;
}

.mgi-icon-feedback::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 42%;
  width: 24rpx;
  height: 18rpx;
  border: 3rpx solid #1677FF;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}

.mgi-icon-feedback::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 60%;
  width: 0;
  height: 0;
  border: 8rpx solid transparent;
  border-top-color: #1677FF;
  border-bottom: none;
  transform: translate(-50%, 0);
}

/* lock - 锁 */
.mgi-icon-lock {
  background: #F5F5F5;
}

.mgi-icon-lock::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 48%;
  width: 24rpx;
  height: 18rpx;
  border: 3rpx solid #999;
  border-radius: 4rpx;
  border-top-width: 6rpx;
  transform: translate(-50%, -50%);
}

.mgi-icon-lock::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 30%;
  width: 14rpx;
  height: 10rpx;
  border: 3rpx solid #999;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
  transform: translate(-50%, 0);
}

/* tier - 等级阶梯 */
.mgi-icon-tier {
  background: #FFF0EB;
}
.mgi-icon-tier::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 20rpx;
  border: 3rpx solid #FF6B35;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}
.mgi-icon-tier::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 36%;
  width: 6rpx;
  height: 6rpx;
  background: #FF6B35;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 10rpx 0 #FF6B35, -8rpx 18rpx 0 #FF6B35, 8rpx 18rpx 0 #FF6B35;
}

/* medal - 勋章 */
.mgi-icon-medal {
  background: #FFFBE6;
}
.mgi-icon-medal::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #FAAD14;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.mgi-icon-medal::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  width: 4rpx;
  height: 12rpx;
  background: #FAAD14;
  transform: translateX(-50%) rotate(15deg);
  border-radius: 2rpx;
  box-shadow: 6rpx 4rpx 0 #FAAD14, -6rpx 4rpx 0 #FAAD14;
}

/* rank - 排行榜 */
.mgi-icon-rank {
  background: #F0F5FF;
}
.mgi-icon-rank::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid #2F54EB;
  transform: translate(-50%, -50%);
}
.mgi-icon-rank::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 10rpx;
  background: #FFFFFF;
  transform: translate(-50%, -4rpx);
  z-index: 1;
}

/* study - 培训 */
.mgi-icon-study {
  background: #E6FFFB;
}
.mgi-icon-study::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 18rpx;
  border: 3rpx solid #13C2C2;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}
.mgi-icon-study::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 38%;
  width: 8rpx;
  height: 8rpx;
  background: #13C2C2;
  border-radius: 50%;
  transform: translate(-50%, 0);
  box-shadow: 0 14rpx 0 #13C2C2;
}

/* info - 信息 */
.mgi-icon-info {
  background: #F0F5FF;
}

.mgi-icon-info::after {
  content: 'i';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 36rpx;
  font-weight: 700;
  color: #2F54EB;
  font-style: italic;
  font-family: serif;
}

/* ---------- 退出登录 ---------- */
.logout-btn {
  text-align: center;
  padding: 28rpx 30rpx;
  color: #FF4D4F;
  font-size: 30rpx;
  font-weight: 500;
  margin: 40rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  min-height: 88rpx;
  line-height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

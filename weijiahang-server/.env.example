# ==========================================
# 为家航 — 环境变量配置
# 复制此文件为 .env 并填入真实值
# ==========================================

# ---- 应用 ----
NODE_ENV=development
PORT=3000
APP_NAME=为家航

# ---- 数据库 (PostgreSQL + PostGIS) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=weijiahang

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d

# ---- CSRF ----
CSRF_SECRET=your_csrf_secret_key_change_me

# ---- 微信小程序 ----
WX_APPID=your_wechat_miniapp_appid
WX_SECRET=your_wechat_miniapp_secret
WX_MCHID=your_wechat_pay_merchant_id
WX_PAY_KEY=your_wechat_pay_key

# ---- 腾讯地图 ----
TENCENT_MAP_KEY=your_tencent_map_api_key

# ---- 腾讯云 IM ----
TIM_SDK_APPID=your_tim_sdk_appid
TIM_SECRET=your_tim_secret

# ---- AI (Claude API) ----
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ---- 文件存储 (腾讯云COS) ----
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=weijiahang-uploads
COS_REGION=ap-guangzhou

# ---- 加密 ----
ID_CARD_ENCRYPT_KEY=your_32_byte_encryption_key_here

# ---- CORS ----
# 生产环境前端域名，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- 日志 ----
LOG_LEVEL=info
# 审计日志保留天数
AUDIT_LOG_RETENTION_DAYS=90

# ---- 速率限制 ----
# 全局限速：次/分钟/IP
RATE_LIMIT_GLOBAL=100
# 认证接口限速
RATE_LIMIT_AUTH=20
# 管理后台限速
RATE_LIMIT_ADMIN=60

# ---- 熔断器 ----
# 失败阈值（触发熔断的最小失败次数）
CB_FAILURE_THRESHOLD=5
# 熔断超时（毫秒）
CB_OPEN_TIMEOUT=60000

# ---- 管理员白名单 ----
# 允许访问 /admin/* 的IP白名单，逗号分隔
ADMIN_IP_WHITELIST=127.0.0.1,::1

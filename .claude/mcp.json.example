{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "enhanced-postgres-mcp-server", "postgresql://user:password@localhost:5432/dbname"],
      "env": {
        "PGPASSWORD": "<你的数据库密码>"
      }
    },
    "redis": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis", "redis://localhost:6379"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<你的GitHub Token>"
      }
    }
  }
}
